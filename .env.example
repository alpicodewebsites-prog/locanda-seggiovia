# Variabili d'ambiente — copiare in `.env` e compilare.
#
# In produzione queste variabili vanno impostate nel pannello di Netlify
# (Site configuration → Environment variables), non committate su Git.

# ---------------------------------------------------------------------------
# Web3Forms — form di contatto
# ---------------------------------------------------------------------------
# 1. Vai su https://web3forms.com e inserisci locandaseggiovia@gmail.com
# 2. Riceverai una Access Key via email (gratuito, 250 invii/mese)
# 3. Incolla la chiave qui sotto e su Netlify/Vercel
#
# Se la chiave è assente il modulo si dichiara in "modalità dimostrativa" e
# l'invio NON recapita nulla: non viene mai inviata email a indirizzi inventati.
PUBLIC_WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# reCAPTCHA v3 — OPZIONALE, solo con piano Web3Forms a pagamento
# ---------------------------------------------------------------------------
# ATTENZIONE: su Web3Forms la verifica reCAPTCHA è una funzione dei piani a
# pagamento. Con il piano gratuito, inviare un campo `recaptcha_response` senza
# un token valido fa RIFIUTARE l'invio.
#
# Per questo lo script e il campo compaiono SOLO se questa variabile è impostata.
# Lasciandola vuota il modulo funziona con il piano gratuito, protetto dal campo
# esca e dal filtro antispam di Web3Forms.
#
# Per attivarla servono DUE cose:
#   - la site key di reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
#   - il piano Web3Forms a pagamento, altrimenti gli invii verranno rifiutati
PUBLIC_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Dominio pubblico — usato da canonical, Open Graph, sitemap e redirect del form
# ---------------------------------------------------------------------------
# Al go-live impostare il dominio definitivo (senza slash finale).
SITE_URL=https://www.locandaseggiovia.com

# ---------------------------------------------------------------------------
# Analytics — opzionale, nessuno script di terze parti è incluso di default
# ---------------------------------------------------------------------------
# Se in futuro si attiva un analytics cookieless (es. Plausible o Umami),
# inserire qui l'URL dello script. Lasciare vuoto per non caricare nulla.
PUBLIC_ANALYTICS_SRC=
