# Dipendenze
node_modules/

# Build
dist/
.astro/

# Vercel (configurazione locale del progetto collegato)
.vercel/

# Immagini di revisione (generate da scripts/shot.mjs, non fanno parte del sito)
screenshots/

# Cache Python (script di generazione immagini)
__pycache__/
*.pyc

# Ambiente
.env
.env.production
.env.local

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.vercel

# Script di servizio locale, non fa parte del sito
CARICA-SU-GITHUB.cmd

# Rete di sicurezza: file di credenziali creati per errore da comandi con
# percorsi assoluti non espansi. Non devono MAI finire nel repository.
Usersaless*
*AppDataLocalTemp*
*.txt.tmp

# --- Uscite grezze del generatore di segnaposto ----------------------------
# `scripts/generate_placeholders.py` scrive nella radice di src/assets con i
# nomi grezzi; `scripts/organizza_immagini.py` li sposta poi nelle cartelle
# giuste con i nomi numerati. Se qualcuno esegue il generatore e non l'ordina,
# quei file resterebbero nel repository come doppioni inutilizzati (è successo).
src/assets/sentieri-*.jpg
src/assets/hero-*.jpg
src/assets/piccole-dolomiti-*.jpg

# Fotogrammi di verifica (scripts/scatta_*.mjs, verifica_cieli)
cieli/
sentiero.png
meteo.png
tavolo.png
menu.png
hero-collegamenti.png
dettagli-foglio.png

# Messaggi di commit scritti su file (per evitare i problemi di virgolette di
# PowerShell). Non devono entrare nel repository: e' successo due volte.
.msg*.txt
.messaggio.txt
