---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Segnavia from '../components/Segnavia.astro';
import RichiestaPrenotazione from '../components/RichiestaPrenotazione.astro';
import { site } from '../data/site';
import { caricaHome } from '../lib/pagine';
import { risolviImmagine } from '../lib/immagini';

/**
 * Testi e fotografie della home, modificabili dal pannello.
 *
 * Arrivano da `src/content/home/pagina.md`: cambiarli lì cambia questa pagina.
 * La voce si chiama «Home Page» nel pannello.
 */
const home = await caricaHome();
const foto = home.foto;
const testi = home.testi;

const imgLocanda = foto.facciata;

/**
 * Le specialità della casa, lette dalla collezione del menù.
 *
 * Prima erano scritte a mano qui dentro, e quindi potevano divergere dal menù
 * vero: bastava cambiare un piatto nel pannello e la home restava indietro.
 * Ora si segnano come «specialità» nella scheda del piatto e compaiono qui.
 */
const menu = await getCollection('menu');

const specialita = menu
  .filter((piatto) => piatto.data.specialita)
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((piatto) => ({
    nome: piatto.data.nome,
    descrizione: piatto.data.descrizione,
    // Gli gnocchi hanno una pagina tutta loro; gli altri portano al ristorante.
    href: piatto.id === 'gnocchi-con-la-fioreta' ? '/gnocchi-con-la-fioreta' : '/ristorante',
    etichetta:
      piatto.id === 'gnocchi-con-la-fioreta' ? 'La storia e la ricetta' : 'Vedi il menù',
  }));

/**
 * Gli ingredienti degli gnocchi, per la fascia «tavolo».
 *
 * Si leggono dalla ricetta vera, non sono riscritti qui: la ricetta sta nella
 * pagina degli gnocchi, e averla in due posti significherebbe vederli divergere
 * alla prima modifica.
 */
const gnocchiTesti = await getEntry('gnocchi', 'testi');
const gnocchiFoto = await getEntry('gnocchi', 'foto');

const ingredienti = gnocchiTesti?.data.ricetta ?? [];

/**
 * Le fotografie degli ingredienti, se ci sono.
 *
 * Si accoppiano alla ricetta per POSIZIONE: la prima foto è il primo
 * ingrediente. Se le foto sono meno degli ingredienti, quelli senza foto
 * mostrano semplicemente il nome — non un riquadro vuoto.
 */
const fotoIngredienti = (gnocchiFoto?.data.fotoIngredienti ?? []).map((valore) =>
  risolviImmagine(valore),
);

/**
 * Home — pagina di apertura.
 *
 * Struttura: quattro fasce a piena larghezza con logiche di impaginazione
 * diverse (non quattro schede identiche). L'unico elemento che si ripete è
 * la riga sottile di separazione, che dà il ritmo.
 */

/** Descrizione per i motori di ricerca: si modifica dal pannello. */
const description = testi.descrizione;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.nome,
  url: site.url,
  inLanguage: 'it-IT',
  publisher: { '@id': `${site.url}/#locanda` },
};

/**
 * I sei itinerari della scheda «Territorio».
 *
 * Si leggono dalla collezione, non sono più scritti qui: prima erano duplicati
 * nel codice, e bastava correggere un sentiero nel pannello perché la home
 * restasse indietro.
 *
 * I dati tecnici si mostrano SOLO se compilati. Un sentiero senza distanza
 * dichiarata non mostra «Distanza: —»: mostra le voci che esistono.
 */
const sentieri = (await getCollection('sentieri'))
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((sentiero) => ({
    id: sentiero.id,
    nome: sentiero.data.nome,
    sommario: sentiero.data.sommario,
    difficolta: sentiero.data.difficolta,
    // Il numero del segnavia, ripulito dal prefisso «CAI »: sul cartello si
    // stampa solo la cifra, come sui cartelli veri.
    numero: sentiero.data.segnavia?.replace(/^CAI\s*/i, '').trim(),
    dati: [
      sentiero.data.distanza && { etichetta: 'Distanza', valore: sentiero.data.distanza },
      sentiero.data.dislivello && { etichetta: 'Dislivello', valore: sentiero.data.dislivello },
      sentiero.data.durata && { etichetta: 'Durata', valore: sentiero.data.durata },
    ].filter((voce): voce is { etichetta: string; valore: string } => Boolean(voce)),
  }));
---

<BaseLayout
  title={`${site.nome} — ${site.tagline}`}
  description={description}
  schema={webPageSchema}
  headerTrasparente={true}
>
  {/* Il testo alternativo dell'apertura è quello predefinito del componente:
      dichiara che l'immagine è un disegno, non uno scatto reale. Non va
      sovrascritto con una descrizione del paesaggio finché la fotografia vera
      non c'è. */}
  <Hero
    immagine={foto.hero}
    titolo={testi.titolo}
    sottotitolo={testi.sottotitolo}
    accessi={testi.accessi}
    invitoSentieri={testi.invitoSentieri}
  />

  <!-- ==================================================================
       Invito alla pagina degli gnocchi
       ------------------------------------------------------------------
       Prima qui c'era una fascia a tre colonne — Dove / Cucina / Sentieri —
       con tre etichette e tre testi. Diceva cose vere ma non chiedeva
       niente: chi leggeva non aveva nulla da fare, e la fascia occupava
       spazio come un riempitivo.

       Ora è un pulsante a pillola, centrato e largo quanto il suo testo: non
       occupa tutta la pagina. La forma tonda lo distingue dagli altri
       comandi del sito, che sono rettangolari, e lo rende il momento in cui
       si può fare qualcosa.

       La freccia è decorativa e nascosta ai lettori di schermo: il testo del
       collegamento dice già dove porta.
       ================================================================== -->
  <!-- ==================================================================
       Il tavolo degli gnocchi
       ------------------------------------------------------------------
       Prima qui c'era solo il pulsante, in mezzo a una fascia vuota: nella
       pagina si vedeva un rettangolo grigio con una scritta dentro.

       Ora la fascia ha il fondo del legno e sopra ci stanno gli ingredienti,
       nell'ordine in cui si usano. Gli ingredienti NON sono scritti qui: si
       leggono dalla ricetta nella pagina degli gnocchi. Se la proprietaria
       cambia una quantità dal pannello, questa fascia si aggiorna da sola —
       e non può succedere che la home dica una cosa e la ricetta un'altra.

       Le fotografie degli ingredienti sono facoltative: quando ci sono, la
       tessera mostra l'immagine; finché non ci sono, resta il nome con la
       quantità, che è comunque l'informazione utile.
       ================================================================== -->
  <section class="tavolo" aria-labelledby="titolo-ingredienti">
    <div class="shell">
      <p class="eyebrow tavolo__etichetta">La ricetta</p>
      <h2 id="titolo-ingredienti" class="display-2 tavolo__titolo">
        Gli ingredienti, uno per uno
      </h2>
      <p class="tavolo__nota">
        Cinque ingredienti, nell'ordine in cui si usano. Sono quelli della ricetta De.Co.:
        niente uova, niente patate.
      </p>

      <ol class="tavolo__elenco">
        {
          ingredienti.map((voce, posizione) => {
            const immagine = fotoIngredienti[posizione];
            return (
              <li class="ingrediente">
                <span class="ingrediente__numero" aria-hidden="true">
                  {String(posizione + 1).padStart(2, '0')}
                </span>

                {immagine && (
                  <span class="ingrediente__foto">
                    <Image
                      src={immagine}
                      alt=""
                      widths={[220, 320, 440]}
                      sizes="(min-width: 768px) 15vw, 40vw"
                      format="webp"
                      quality={82}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}

                <span class="ingrediente__nome">{voce.ingrediente}</span>
                <span class="ingrediente__quantita">{voce.quantita}</span>
              </li>
            );
          })
        }
      </ol>

      <div class="tavolo__invito">
        <a href="/gnocchi-con-la-fioreta" class="pulsante-gnocchi">
          {testi.pulsanteGnocchi}
          <span class="pulsante-gnocchi__freccia" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>


  <!-- ==================================================================
       1. La Locanda — impaginazione editoriale asimmetrica
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-locanda">
    <div class="shell grid items-center gap-12 md:grid-cols-12 md:gap-10 lg:gap-16">
      <div class="md:col-span-5 md:order-2">
        {
          imgLocanda && (
            <div class="media aspect-4/5">
              <Image
                src={imgLocanda}
                alt="La Locanda Seggiovia in piazza a Recoaro Terme, con i balconi in legno e le Piccole Dolomiti sullo sfondo"
                widths={[420, 600, 900]}
                sizes="(min-width: 768px) 40vw, 92vw"
                format="webp"
                quality={84}
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </div>

      <div class="md:col-span-7 md:order-1">
        <p class="eyebrow text-forest-500">{testi.locandaEtichetta}</p>
        <h2 id="titolo-locanda" class="display-2 mt-4 max-w-[22ch] text-stone-900">
          {testi.locandaTitolo}
        </h2>
        <span class="filo-accento" aria-hidden="true"></span>

        <div class="prose-body mt-7 max-w-[62ch] space-y-0 text-[1.0625rem] text-stone-600">
          {
            testi.locandaParagrafi.map((paragrafo) => (
              <p>{paragrafo}</p>
            ))
          }
        </div>

        <p class="mt-8">
          <a href="/la-locanda" class="link-arrow">
            {testi.locandaCollegamento}
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path
                d="M1 5h11m0 0L8.5 1.5M12 5l-3.5 3.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       2. Territorio — il tabellone dei sentieri
       ------------------------------------------------------------------
       Sei schede, una per itinerario. Ogni scheda porta il cartello CAI con
       il numero del sentiero (dove esiste), il nome, il sommario e i dati
       tecnici ETICHETTATI: «Distanza: 12 km» invece di «12 km» buttato a
       destra, che non diceva niente a chi non lo sapeva già.
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-territorio">
    <div class="shell">
      <div class="grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="eyebrow text-wood-500">{testi.territorioEtichetta}</p>
          <h2 id="titolo-territorio" class="display-2 mt-4 max-w-[24ch] text-stone-900">
            {testi.territorioTitolo}
          </h2>
          <span class="filo-accento filo-accento--legno" aria-hidden="true"></span>
        </div>
        <div class="md:col-span-5">
          <p class="lede text-[1rem]">{testi.territorioTesto}</p>
        </div>
      </div>

      <ul class="mt-12 grid gap-x-10 gap-y-0 md:mt-14 md:grid-cols-2">
        {
          sentieri.map((s) => (
            <li class="scheda-sentiero">
              <a href={`/sentieri/${s.id}`} class="scheda-sentiero__link">
                <Segnavia numero={s.numero} nome={s.nome} />

                <h3 class="scheda-sentiero__nome">{s.nome}</h3>

                <p class="scheda-sentiero__testo">{s.sommario}</p>

                <dl class="scheda-sentiero__dati">
                  {s.dati.map((dato) => (
                    <div class="scheda-sentiero__dato">
                      <dt>{dato.etichetta}</dt>
                      <dd>{dato.valore}</dd>
                    </div>
                  ))}
                  <div class="scheda-sentiero__dato">
                    <dt>Difficoltà</dt>
                    <dd>{s.difficolta}</dd>
                  </div>
                </dl>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Legenda CAI: in un riquadro, così si trova senza cercarla. -->
      <div class="mt-14 rounded-[var(--raggio-media)] border border-forest-300/60 bg-forest-100/60 p-6 md:p-8">
        <h3 class="font-[family-name:var(--font-display)] text-xl text-stone-900">
          Come si leggono le difficoltà
        </h3>
        <p class="mt-2 max-w-[62ch] text-[0.9rem] leading-relaxed text-stone-600">
          È la scala del Club Alpino Italiano, quella che si trova sui cartelli lungo i
          sentieri.
        </p>
        <dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-3">
          {
            [
              { sigla: 'T', nome: 'Turistico', nota: 'Sentieri pianeggianti o poco ripidi, adatti a tutti.' },
              {
                sigla: 'E',
                nome: 'Escursionistico',
                nota: 'Serve allenamento e scarpe adatte. Sentieri su terreno anche ripido.',
              },
              {
                sigla: 'EE',
                nome: 'Escursionisti esperti',
                nota: 'Terreno impervio, a tratti esposto. Serve esperienza e passo sicuro.',
              },
            ].map((voce) => (
              <div class="border-t border-forest-300/70 pt-4">
                <dt class="flex items-baseline gap-2">
                  <span class="font-[family-name:var(--font-display)] text-lg font-semibold text-stone-900">
                    {voce.sigla}
                  </span>
                  <span class="text-[0.9rem] font-medium text-stone-700">{voce.nome}</span>
                </dt>
                <dd class="mt-1.5 text-[0.85rem] leading-relaxed text-stone-600">{voce.nota}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mt-10">
        <a href="/sentieri" class="btn btn--primary">Tutti i sentieri</a>
      </div>
    </div>
  </section>


  <!-- ==================================================================
       3. Gastronomia — fascia scura a piena larghezza
       ================================================================== -->
  <section class="section-y bg-forest-900 text-stone-200" aria-labelledby="titolo-cucina">
    <div class="shell grid gap-12 md:grid-cols-2 md:gap-14 lg:gap-20">
      <div>
        <p class="eyebrow text-glow-300">Cucina</p>
        <h2 id="titolo-cucina" class="display-2 mt-4 text-stone-50">
          Quello che si cucina in vallata
        </h2>
        <span class="filo-accento filo-accento--alba" aria-hidden="true"></span>
        <p class="mt-7 max-w-[46ch] text-[0.95rem] leading-relaxed text-forest-300">
          Il menù segue le stagioni e le malghe, non le mode. Il bacalà arriva da una
          tradizione lunga, la sopressa si fa in casa.
        </p>
        <p class="mt-8">
          <a href="/ristorante" class="link-arrow text-stone-100">Il ristorante</a>
        </p>
      </div>

      <div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            specialita.map((piatto) => (
              <li>
                <a href={piatto.href} class="scheda-piatto card-accento card-accento--alba">
                  <h3 class="scheda-piatto__nome">{piatto.nome}</h3>
                  <p class="scheda-piatto__testo">{piatto.descrizione}</p>
                  <span class="scheda-piatto__invito">
                    <span class="scheda-piatto__etichetta">{piatto.etichetta}</span>
                    <svg
                      class="scheda-piatto__freccia"
                      width="16"
                      height="11"
                      viewBox="0 0 16 11"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M1 5.5h13m0 0L10 1.5m4 4l-4 4"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       4. Richiesta di disponibilità
       ------------------------------------------------------------------
       Prima dell'ultima fascia: quando chi guarda ha visto le camere, i
       sentieri e la cucina, e ha una domanda da fare.
       ================================================================== -->
  <RichiestaPrenotazione />

  <!-- ==================================================================
       5. Chiusura
       ------------------------------------------------------------------
       Era una fascia scura a piena larghezza con un'immagine di sfondo.
       Faceva da tappo a metà pagina e, finché la fotografia vera non c'è,
       ci si vedeva dentro l'etichetta di segnaposto. Ora è una chiusura
       sobria sul fondo della pagina: lo spazio e la tipografia bastano.
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-chiusura">
    <div class="shell text-center">
      <h2 id="titolo-chiusura" class="display-2 mx-auto max-w-[24ch] text-stone-900">
        Ti aspettiamo in piazza
      </h2>
      <p class="mx-auto mt-6 max-w-[52ch] text-[1.0625rem] leading-relaxed text-stone-600">
        Per prenotare una camera, un tavolo o per chiedere informazioni su un sentiero,
        scrivici o chiamaci. Rispondiamo noi.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a href="/contatti" class="btn btn--primary">Scrivici</a>
        <a href={site.telefonoLink} class="btn btn--ghost">{site.telefono}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Schede dei piatti — la risposta al passaggio del mouse e al focus.

    Il piatto è tutto cliccabile: portare il puntatore su un punto qualsiasi
    della scheda la rende una meta, e su un telefono la superficie da toccare
    è grande. Il movimento è minimo e serve a dire «questa si può aprire»:

      - la linea sotto il nome si allunga da sinistra (250 ms, ease-out)
      - la freccia scorre dentro e compare
      - lo sfondo si scalda di poco

    Niente zoom dell'immagine: le schede non hanno fotografia, perché al momento
    solo gli gnocchi ne hanno una e una foto su quattro schede squilibrerebbe la
    griglia. Lo zoom è invece sulla pagina Ristorante, dove le foto ci sono.

    Informazioni utili restano sempre visibili: qui non si nasconde nulla dietro
    al passaggio del mouse, che su un telefono non esiste.
  */
  .scheda-piatto {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.25rem 1.25rem 1.5rem;
    text-decoration: none;
    transition:
      background-color 250ms ease-out,
      border-color 250ms ease-out;
  }

  @media (min-width: 768px) {
    .scheda-piatto {
      padding: 1.5rem 1.5rem 1.75rem;
    }
  }

  .scheda-piatto__nome {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-stone-900);
  }

  /* La linea che si allunga da sinistra sotto il nome. */
  .scheda-piatto__nome::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-acc-alba);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 250ms ease-out;
  }

  .scheda-piatto__testo {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-stone-600);
  }

  .scheda-piatto__invito {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-acc-alba);
  }

  .scheda-piatto__freccia {
    flex: none;
    transform: translateX(-0.3rem);
    opacity: 0;
    transition:
      transform 250ms ease-out,
      opacity 250ms ease-out;
  }

  .scheda-piatto:hover .scheda-piatto__nome::after,
  .scheda-piatto:focus-visible .scheda-piatto__nome::after {
    transform: scaleX(1);
  }

  .scheda-piatto:hover .scheda-piatto__freccia,
  .scheda-piatto:focus-visible .scheda-piatto__freccia {
    transform: translateX(0);
    opacity: 1;
  }

  .scheda-piatto:hover,
  .scheda-piatto:focus-visible {
    background-color: color-mix(in srgb, var(--color-acc-alba) 20%, white);
  }

  .scheda-piatto:focus-visible {
    outline: 2px solid var(--color-forest-700);
    outline-offset: 2px;
  }

  /* Chi ha chiesto meno movimento vede gli stati finali, senza transizione. */
  @media (prefers-reduced-motion: reduce) {
    .scheda-piatto,
    .scheda-piatto__nome::after,
    .scheda-piatto__freccia {
      transition: none;
    }

    .scheda-piatto:hover .scheda-piatto__nome::after,
    .scheda-piatto:focus-visible .scheda-piatto__nome::after {
      transform: scaleX(1);
    }

    .scheda-piatto__freccia {
      transform: none;
      opacity: 1;
    }
  }
</style>
