---
/**
 * Home — pagina di apertura.
 *
 * ----------------------------------------------------------------------------
 * COM'È FATTA, DOPO LO SNELIMENTO
 *
 *  1. L'apertura, con la fotografia e i due accessi (dormire / mangiare).
 *  2. Il carosello: quattro fotografie che portano alle pagine dedicate.
 *  3. Due righe sulla locanda, con il collegamento alla storia.
 *  4. La chiusura, con l'invito a scrivere.
 *
 * PRIMA C'ERA TUTTO
 * Il menù con le specialità, l'elenco dei sette sentieri con la legenda CAI, il
 * riquadro degli gnocchi e il modulo di prenotazione: la home ripeteva per
 * intero quattro altre pagine. Chi arrivava non capiva da dove cominciare, e
 * ogni modifica andava fatta in due posti. Ora la home indica la strada; il
 * contenuto sta dove uno se lo aspetta.
 * ----------------------------------------------------------------------------
 *
 * Bilingue: i testi dell'interfaccia stanno in `src/i18n/pagine.ts`, quelli
 * modificabili in `src/content/home/` (uno per lingua).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Carosello from '../components/Carosello.astro';
import AperturaLingua from '../components/AperturaLingua.astro';
import { site } from '../data/site';
import { caricaHome } from '../lib/pagine';
import { linguaDaUrl, percorsoLocalizzato, type Lingua } from '../i18n';
import { testiPagina } from '../i18n/pagine';

export interface Props {
  /** Forzata dal guscio inglese, che rende questa pagina come componente. */
  lingua?: Lingua;
}

const lingua = Astro.props.lingua ?? linguaDaUrl(Astro.url);
const t = testiPagina(lingua).home;

/**
 * Testi e fotografie della home, modificabili dal pannello.
 * La voce si chiama «Home Page» nei contenuti.
 */
const home = await caricaHome(lingua);
const foto = home.foto;
const testi = home.testi;

/** Descrizione per i motori di ricerca: si modifica dal pannello. */
const description = testi.descrizione;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.nome,
  url: site.url,
  inLanguage: lingua === 'en' ? 'en' : 'it-IT',
  publisher: { '@id': `${site.url}/#locanda` },
};

/*
  Le diapositive del carosello arrivano dal pannello. Se la cliente le svuota,
  la sezione sparisce invece di lasciare un buco: meglio una home più corta che
  un riquadro vuoto.
*/
const diapositive = (testi.carosello ?? []).filter(
  (voce) => voce.titolo && voce.testo && voce.collegamento,
);
---

<BaseLayout
  title={`${site.nome} — ${lingua === 'en' ? site.taglineEn : site.tagline}`}
  description={description}
  schema={webPageSchema}
  headerTrasparente={true}
  lingua={lingua}
>
  {/* La scelta della lingua, solo qui: chi arriva su un sentiero da Google
      vuole quel sentiero, non una dogana. */}
  <AperturaLingua lingua={lingua} />

  {/* Il testo alternativo dell'apertura è quello predefinito del componente:
      dichiara che l'immagine è un disegno, non uno scatto reale. */}
  <Hero
    immagine={foto.hero}
    titolo={testi.titolo}
    sottotitolo={testi.sottotitolo}
    accessi={testi.accessi}
    invitoSentieri={testi.invitoSentieri}
    invitoGnocchi={testi.pulsanteGnocchi}
    lingua={lingua}
  />

  {
    diapositive.length > 0 && (
      <Carosello
        diapositive={diapositive}
        lingua={lingua}
        etichetta={t.titoloCarosello}
        invito={t.invitoCarosello}
        precedente={t.precedente}
        successiva={t.successiva}
      />
    )
  }

  <!-- ==================================================================
       La locanda, in due righe
       ================================================================== -->
  <section class="section-y fantasia fantasia-2 bg-stone-50" aria-labelledby="titolo-locanda">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow text-forest-500">{testi.locandaEtichetta}</p>
        <h2 id="titolo-locanda" class="display-2 mt-4 max-w-[16ch] text-stone-900">
          {testi.locandaTitolo}
        </h2>
        <span class="filo-accento" aria-hidden="true"></span>
      </div>

      <div class="md:col-span-8">
        <div class="space-y-5">
          {
            (testi.locandaParagrafi ?? []).map((paragrafo) => (
              <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-stone-600">
                {paragrafo}
              </p>
            ))
          }
        </div>

        <p class="mt-8">
          <a href={percorsoLocalizzato('/la-locanda', lingua)} class="link-arrow">
            {testi.locandaCollegamento}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Chiusura
       ================================================================== -->
  <section class="section-y-tight bg-forest-900 text-stone-200">
    <div class="shell flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="display-2 max-w-[24ch] text-stone-50">{t.titoloChiusura}</h2>
        <p class="mt-4 max-w-[48ch] text-[1rem] leading-relaxed text-forest-300">
          {t.testoChiusura}
        </p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href={percorsoLocalizzato('/camere', lingua)} class="btn btn--onDark">
          {t.pulsanteCamere}
        </a>
        <a href={percorsoLocalizzato('/contatti', lingua)} class="btn btn--onDark">
          {t.pulsanteScrivici}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
