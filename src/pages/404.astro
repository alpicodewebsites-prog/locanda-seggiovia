---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigazione } from '../data/site';
---

<BaseLayout
  title="Pagina non trovata"
  description="La pagina cercata non esiste. Torna alla home della Locanda Seggiovia o consulta i sentieri delle Piccole Dolomiti."
  noindex={true}
>
  <section class="shell flex min-h-[60svh] flex-col justify-center py-24">
    <p class="eyebrow">Errore 404</p>
    <h1 class="display-2 mt-4 max-w-[20ch] text-stone-900">
      Questo sentiero non porta da nessuna parte
    </h1>
    <p class="lede mt-6">
      La pagina che cerchi è stata spostata o non è mai esistita. Da qui puoi tornare
      indietro oppure andare direttamente dove serve.
    </p>

    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-[0.95rem]">
      <li><a href="/" class="link-arrow">Home</a></li>
      {
        navigazione.map((voce) => (
          <li>
            <a href={voce.href} class="link-arrow">
              {voce.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
