---
/**
 * Gnocchi con la Fioreta — pagina dedicata.
 *
 * È una sezione autonoma, non una sottosezione del ristorante: il piatto è un
 * prodotto bandiera De.Co. e ha una storia che sta in piedi da sola.
 * I contenuti si gestiscono dal pannello /admin (collezione `gnocchi`).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../data/site';
import { risolviImmagine } from '../lib/immagini';

const voci = await getCollection('gnocchi');
const gnocchi = voci[0];

if (!gnocchi) {
  throw new Error(
    'Collezione "gnocchi" vuota: manca src/content/gnocchi/fioreta.md. ' +
      'Senza quel contenuto la pagina non ha nulla da mostrare.',
  );
}

const d = gnocchi.data;

/** Le due fotografie arrivano dal contenuto, quindi dal pannello. */
const fotoFioreta = risolviImmagine(d.foto);
const fotoPreparazione = risolviImmagine(d.fotoPreparazione);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.titolo,
  description: d.storia,
  url: `${SITE_URL}/gnocchi-con-la-fioreta`,
  inLanguage: 'it-IT',
  recipeCategory: 'Primi piatti',
  recipeCuisine: 'Cucina alto-vicentina',
  keywords: 'gnocchi con la fioreta, De.Co., Recoaro Terme, cucina vicentina',
  author: { '@id': `${SITE_URL}/#locanda` },
  publisher: { '@id': `${SITE_URL}/#locanda` },
  image: `${SITE_URL}/og-default.jpg`,
  recipeIngredient: d.ricetta.map((r) => `${r.quantita} di ${r.ingrediente.toLowerCase()}`),
  recipeInstructions: d.lavorazione.map((fase) => ({
    '@type': 'HowToStep',
    name: fase.titolo,
    text: fase.testo,
  })),
};
---

<BaseLayout
  title="Gnocchi con la Fioreta — prodotto De.Co."
  description="Storia, ricetta De.Co. e lavorazione degli Gnocchi con la Fioreta di Recoaro Terme: 1,5 litri di fioreta, 1 kg di farina bianca, burro di malga rosolato."
  schema={schema}
>
  <!-- ==================================================================
       Apertura
       ================================================================== -->
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Prodotto bandiera</p>
        <h1 class="display-2 mt-5 max-w-[20ch] text-stone-900">{d.titolo}</h1>
        {d.sottotitolo && <p class="lede mt-6 max-w-[54ch]">{d.sottotitolo}</p>}
      </div>

      <div class="md:col-span-5">
        {
          fotoFioreta && (
            <div class="media aspect-4/3">
              <Image
                src={fotoFioreta}
                alt="Gli gnocchi con la fioreta serviti nel piatto, conditi con il burro di malga rosolato"
                widths={[300, 420, 640]}
                sizes="(min-width: 768px) 40vw, 92vw"
                format="webp"
                quality={84}
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Storia
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-storia">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10" data-aos="fade-up">
      <div class="md:col-span-4">
        <h2 id="titolo-storia" class="display-2 max-w-[16ch] text-stone-900">
          Da dove viene la fioreta
        </h2>
      </div>
      <div class="prose-body md:col-span-8">
        <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-stone-600">
          {d.storia}
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Ricetta De.Co. — impaginata come una ricetta, non come una tabella
       ================================================================== -->
  <section class="section-y sezione-legno" aria-labelledby="titolo-ricetta">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow">Ricetta De.Co.</p>
        <h2 id="titolo-ricetta" class="display-2 mt-4 max-w-[18ch] text-stone-900">
          Due ingredienti, nessuna scorciatoia
        </h2>
        <p class="mt-6 max-w-[46ch] text-[0.95rem] leading-relaxed text-stone-600">
          La ricetta depositata è breve perché non c'è molto da aggiungere: quello che
          conta è la qualità della fioreta e la mano di chi impasta.
        </p>
      </div>

      <div class="md:col-span-7">
        <dl class="border-t border-stone-300">
          {
            d.ricetta.map((riga) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-stone-200 py-5">
                <dt class="text-[1.05rem] text-stone-800">{riga.ingrediente}</dt>
                <dd class="tariffe__prezzo shrink-0 text-stone-800">{riga.quantita}</dd>
              </div>
            ))
          }
        </dl>

        {
          fotoPreparazione && (
            <figure class="mt-8">
              <div class="media aspect-3/4 max-w-[18rem]">
                <Image
                  src={fotoPreparazione}
                  alt="Gli ingredienti disposti sul tavolo di cucina: la fioreta, la farina, il burro e il formaggio di malga"
                  widths={[300, 420, 600]}
                  sizes="(min-width: 768px) 18rem, 60vw"
                  format="webp"
                  quality={84}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mt-3 max-w-[42ch] text-[0.8rem] leading-relaxed text-stone-500">
                Gli ingredienti sul tavolo di cucina: fioreta, farina bianca, burro e
                formaggio di malga.
              </figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Lavorazione — qui sì, è una sequenza: i numeri hanno senso
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-lavorazione">
    <div class="shell">
      <h2 id="titolo-lavorazione" class="display-2 max-w-[22ch] text-stone-900">
        La lavorazione
      </h2>

      <ol class="mt-12 grid gap-px overflow-hidden bg-stone-300 md:grid-cols-3">
        {
          d.lavorazione.map((fase, i) => (
            <li
              class:list={[
                'bg-stone-100 p-7 md:p-8 card-accento',
                i === 0 && 'card-accento--bosco',
                i === 1 && 'card-accento--legno',
                i === 2 && 'card-accento--alba',
              ]}
            >
              <span
                class="font-[family-name:var(--font-display)] text-[0.9rem] tabular-nums text-stone-400"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-[family-name:var(--font-display)] text-xl leading-snug text-stone-900">
                {fase.titolo}
              </h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-stone-600">{fase.testo}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ==================================================================
       Condimento e riconoscimenti
       ================================================================== -->
  <section class="section-y-tight bg-forest-900 text-stone-200" aria-labelledby="titolo-condimento">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10" data-aos="fade-up">
      <div class="md:col-span-7">
        <h2 id="titolo-condimento" class="display-2 max-w-[20ch] text-stone-50">
          Il condimento
        </h2>
        <p class="mt-6 max-w-[56ch] text-[1.0625rem] leading-relaxed text-forest-300">
          {d.condimento}
        </p>
      </div>

      {
        d.riconoscimenti.length > 0 && (
          <div class="md:col-span-5">
            <h3 class="eyebrow text-forest-300">Riconoscimenti</h3>
            <ul class="mt-4 space-y-3 border-t border-stone-50/20 pt-4">
              {d.riconoscimenti.map((r) => (
                <li class="font-[family-name:var(--font-display)] text-lg leading-snug text-stone-50">
                  {r}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="shell mt-14">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/ristorante" class="btn btn--onDark">Il ristorante</a>
        <a href="/contatti" class="btn btn--onDark">Prenota un tavolo</a>
      </div>
    </div>
  </section>
</BaseLayout>
