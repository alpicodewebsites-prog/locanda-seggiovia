---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import RichiestaPrenotazione from '../components/RichiestaPrenotazione.astro';
import { site } from '../data/site';
import { caricaFotoSito } from '../lib/foto-sito';
import { risolviImmagine } from '../lib/immagini';

const foto = await caricaFotoSito();

const camere = (await getCollection('camere')).sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * Politiche di soggiorno.
 *
 * I valori sono quelli forniti dalla cliente. Il supplemento per gli animali
 * comprende due voci distinte (giornaliero + pulizie finali): sono tenute
 * separate perché sono due addebiti diversi.
 */
const politiche = [
  { voce: 'Bambini 0–3 anni', valore: 'Gratuiti' },
  { voce: 'Bambini 4–10 anni', valore: 'Sconto 30%' },
  { voce: 'Animali domestici', valore: `${site.animali.supplementoGiorno} € al giorno + ${site.animali.pulizieFinali} € di pulizie finali` },
  { voce: 'Soggiorno minimo', valore: `${site.soggiornoMinimo} giorni` },
  { voce: 'Doppia uso singola', valore: `Supplemento ${site.supplementoDus} € al giorno` },
];

const description =
  'Camere singole e doppie a Recoaro Terme con Wi-Fi, TV, cassaforte e set di cortesia. Tariffe per persona da 55 €. Soggiorno minimo 3 giorni.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Camere e tariffe — Locanda Seggiovia',
  url: `${site.url}/camere`,
  itemListElement: camere.map((camera, i) => ({
    '@type': 'Offer',
    position: i + 1,
    name: camera.data.titolo,
    description: camera.data.descrizione,
    priceCurrency: 'EUR',
    price: camera.data.tariffe.bnb,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: camera.data.tariffe.bnb,
      priceCurrency: 'EUR',
      unitText: 'per persona, per giorno',
    },
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${site.url}/#locanda` },
  })),
};
---

<BaseLayout title="Camere e tariffe" description={description} schema={schema} ogImage="/og-default.jpg">
  {/*
    Il contenuto è avvolto in un contenitore con fondo proprio: la pagina delle
    camere ha un tono leggermente diverso dal resto del sito, così non sembra
    la stessa pagina vuota. Le fasce interne che hanno già un loro fondo
    (la tabella tariffe, l'invito finale) coprono questo senza problemi.
  */}
  <div class="sezione-camere">
    <!-- ==================================================================
         Intestazione
         ================================================================== -->
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell">
      <p class="eyebrow">Camere e tariffe</p>
      <h1 class="display-2 mt-5 max-w-[20ch] text-stone-900">
        Camere semplici ed accoglienti
      </h1>
    </div>
  </section>

  <!-- ==================================================================
       Le camere
       ------------------------------------------------------------------
       Ogni camera mostra la propria fotografia, se esiste. Se non esiste,
       al suo posto c'è un riquadro che DICHIARA di essere un segnaposto e
       dice quale fotografia manca.

       Prima qui c'era la fotografia del tavolo di cucina: un'immagine
       fuori contesto in una pagina di camere. Meglio un riquadro onesto
       che una fotografia sbagliata, che confonde e fa sembrare il sito
       approssimativo.
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-camere">
    <div class="shell">
      <h2 id="titolo-camere" class="display-2 max-w-[24ch] text-stone-900">
        Due tipi di camera
      </h2>

      <div class="mt-12 space-y-14">
        {
          camere.map((camera, i) => {
            const immagine = risolviImmagine(camera.data.foto);

            return (
              <article
                class:list={[
                  'grid gap-8 md:grid-cols-12 md:gap-10 lg:gap-14',
                  i > 0 && 'border-t border-stone-300 pt-14',
                ]}
              >
                <div class="md:col-span-5">
                  {immagine ? (
                    <div class="media aspect-4/3">
                      <Image
                        src={immagine}
                        alt={`La ${camera.data.titolo.toLowerCase()} della Locanda Seggiovia`}
                        widths={[420, 600, 900]}
                        sizes="(min-width: 768px) 40vw, 92vw"
                        format="webp"
                        quality={84}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div
                      class="segnaposto-foto aspect-4/3"
                      role="img"
                      aria-label={`Fotografia in arrivo: ${camera.data.titolo}`}
                    >
                      <span class="segnaposto-foto__titolo">Foto in arrivo</span>
                      <span class="segnaposto-foto__soggetto">{camera.data.titolo}</span>
                    </div>
                  )}
                </div>

                <div class="md:col-span-7">
                  <h3 class="font-[family-name:var(--font-display)] text-2xl leading-snug text-stone-900">
                    {camera.data.titolo}
                  </h3>

                  {camera.data.occupanti && <p class="eyebrow mt-2">{camera.data.occupanti}</p>}

                  <p class="mt-4 max-w-[56ch] text-[1.0625rem] leading-relaxed text-stone-600">
                    {camera.data.descrizione}
                  </p>

                  {camera.data.servizi.length > 0 && (
                    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.875rem] text-stone-600">
                      {camera.data.servizi.map((servizio) => (
                        <li class="flex items-center gap-2">
                          <span
                            class="inline-block h-[3px] w-[3px] shrink-0 rounded-full bg-forest-500"
                            aria-hidden="true"
                          />
                          {servizio}
                        </li>
                      ))}
                    </ul>
                  )}

                  {i === 0 && (
                    <p class="mt-5 max-w-[52ch] text-[0.85rem] leading-relaxed text-stone-500">
                      La colazione è compresa nella tariffa B&amp;B. La linea Wi-Fi è disponibile su
                      richiesta negli spazi comuni.
                    </p>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Tabella tariffe
       ================================================================== -->
  <section class="section-y sezione-legno" aria-labelledby="titolo-tariffe">
    <div class="shell">
      <p class="eyebrow text-wood-500">Prezzi</p>
      <h2 id="titolo-tariffe" class="display-2 mt-4 max-w-[26ch] text-stone-900">
        Tariffe
      </h2>
      <span class="filo-accento filo-accento--legno" aria-hidden="true"></span>
      <p class="lede mt-6 max-w-[60ch] text-[1rem]">
        Prezzi per persona, per giorno. Invariati sia in stagione estiva
        (1 giugno – 15 settembre) sia in stagione invernale (16 settembre – 31 maggio).
      </p>

      <div class="mt-10 overflow-x-auto">
        <table class="tariffe min-w-[34rem]">
          <caption class="sr-only">
            Tariffe per camera e trattamento, in euro per persona al giorno
          </caption>
          <thead>
            <tr>
              <th scope="col">Camera</th>
              <th scope="col">B&amp;B</th>
              <th scope="col">Mezza pensione</th>
              <th scope="col">Pensione completa</th>
            </tr>
          </thead>
          <tbody>
            {
              camere.map((camera) => (
                <tr>
                  <th scope="row">{camera.data.titolo}</th>
                  <td class="tariffe__prezzo">{camera.data.tariffe.bnb} €</td>
                  <td class="tariffe__prezzo">{camera.data.tariffe.mezzaPensione} €</td>
                  <td class="tariffe__prezzo">{camera.data.tariffe.pensioneCompleta} €</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">
                Doppia uso singola
                <span class="block text-[0.8rem] font-normal text-stone-500">
                  supplemento
                </span>
              </th>
              <td colspan="3" class="tariffe__prezzo">+ {site.supplementoDus} € / giorno</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-[70ch] text-[0.875rem] leading-relaxed text-stone-500">
        Le tariffe si intendono per persona e per giorno. Il soggiorno minimo è di
        {site.soggiornoMinimo} giorni.
      </p>
    </div>
  </section>


  <!-- ==================================================================
       Richiesta di disponibilità
       ------------------------------------------------------------------
       Subito dopo le tariffe: è il momento in cui si decide. Prima hanno
       visto le camere e i prezzi, adesso possono chiedere.
       ================================================================== -->
  <RichiestaPrenotazione
    titolo="Verifica le date"
    descrizione="Dicci quando vorresti venire e quante persone siete. Ti rispondiamo noi, di solito entro un giorno."
    id="modulo-prenotazione-camere"
  />

  <!-- ==================================================================
       Politiche e servizi
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-politiche">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow text-forest-500">Regole</p>
        <h2 id="titolo-politiche" class="display-2 mt-4 max-w-[20ch] text-stone-900">
          Bambini, animali e regole
        </h2>
        <span class="filo-accento" aria-hidden="true"></span>
        <p class="mt-6 max-w-[52ch] text-[0.95rem] leading-relaxed text-stone-600">
          Poche regole, chiare. Se avete esigenze particolari — un lettino, una cena
          anticipata, un cane di taglia grande — ditecelo al momento della prenotazione.
        </p>
      </div>

      <div class="md:col-span-7">
        <dl class="politica border-t border-stone-300">
          {
            politiche.map((p) => (
              <div class="contents">
                <dt class="border-b border-stone-200 py-4">{p.voce}</dt>
                <dd class="border-b border-stone-200 py-4 text-right">{p.valore}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Chiusura
       ================================================================== -->
  <section class="section-y-tight bg-forest-900 text-stone-200">
    <div class="shell flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="display-2 max-w-[24ch] text-stone-50">Verifica le date</h2>
        <p class="mt-4 max-w-[48ch] text-[1rem] leading-relaxed text-forest-300">
          Scrivici o chiamaci: ti diciamo subito disponibilità e prezzo esatto per il tuo
          soggiorno.
        </p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href="/contatti" class="btn btn--onDark">Scrivici</a>
        <a href={site.telefonoLink} class="btn btn--onDark">{site.telefono}</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
