---
/**
 * Camere e tariffe.
 *
 * Bilingue: i testi dell'interfaccia stanno in `src/i18n/pagine.ts`, le schede
 * delle camere in `src/content/camere/` (una per lingua). I prezzi sono gli
 * stessi nelle due versioni: sono dati, non testo.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import RichiestaPrenotazione from '../components/RichiestaPrenotazione.astro';
import { site } from '../data/site';
import { risolviImmagine } from '../lib/immagini';
import { schedeLingua } from '../lib/contenuti';
import { linguaDaUrl, percorsoLocalizzato, riempi, type Lingua } from '../i18n';
import { testiPagina } from '../i18n/pagine';

export interface Props {
  /** Forzata dal guscio inglese, che rende questa pagina come componente. */
  lingua?: Lingua;
}

const lingua = Astro.props.lingua ?? linguaDaUrl(Astro.url);
const t = testiPagina(lingua).camere;

const camere = schedeLingua(await getCollection('camere'), lingua).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);

/**
 * Politiche di soggiorno.
 *
 * I valori sono quelli forniti dalla cliente. Il supplemento per gli animali
 * comprende due voci distinte (giornaliero + pulizie finali): restano separate
 * perché sono due addebiti diversi.
 */
const politiche = [
  { voce: t.politiche.bambini03, valore: t.valori.gratuiti },
  { voce: t.politiche.bambini410, valore: t.valori.sconto30 },
  {
    voce: t.politiche.animali,
    valore: riempi(t.valori.animali, {
      giorno: String(site.animali.supplementoGiorno),
      pulizie: String(site.animali.pulizieFinali),
    }),
  },
  {
    voce: t.politiche.soggiornoMinimo,
    valore: riempi(t.valori.soggiorno, { giorni: String(site.soggiornoMinimo) }),
  },
  {
    voce: t.politiche.doppiaUsoSingola,
    valore: riempi(t.valori.supplementoDus, { valore: String(site.supplementoDus) }),
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: `${t.metaTitolo} — ${site.nome}`,
  url: `${site.url}${percorsoLocalizzato('/camere', lingua)}`,
  inLanguage: lingua === 'en' ? 'en' : 'it-IT',
  itemListElement: camere.map((camera, i) => ({
    '@type': 'Offer',
    position: i + 1,
    name: camera.data.titolo,
    description: camera.data.descrizione,
    priceCurrency: 'EUR',
    price: camera.data.tariffe.bnb,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: camera.data.tariffe.bnb,
      priceCurrency: 'EUR',
      unitText: t.notaTariffe.replace('{giorni}', String(site.soggiornoMinimo)),
    },
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${site.url}/#locanda` },
  })),
};
---

<BaseLayout
  title={t.metaTitolo}
  description={t.metaDescrizione}
  schema={schema}
  ogImage="/og-default.jpg"
  lingua={lingua}
>
  {/*
    Il contenuto è avvolto in un contenitore con fondo proprio: la pagina delle
    camere ha un tono leggermente diverso dal resto del sito, così non sembra
    la stessa pagina vuota.
  */}
  <div class="sezione-camere">
    <!-- Intestazione -->
    <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
      <div class="shell">
        <p class="eyebrow">{t.etichetta}</p>
        <h1 class="display-2 mt-5 max-w-[20ch] text-stone-900">
          {t.titolo}
        </h1>
      </div>
    </section>

    <!-- ==================================================================
         Le camere
         ================================================================== -->
    <section class="section-y" aria-labelledby="titolo-camere">
      <div class="shell">
        <h2 id="titolo-camere" class="display-2 max-w-[24ch] text-stone-900">
          {t.titoloCamere}
        </h2>

        <div class="mt-12 space-y-14">
          {
            camere.map((camera, i) => {
              const immagine = risolviImmagine(camera.data.foto);
              const nome = camera.data.titolo.toLowerCase();

              return (
                <article
                  class:list={[
                    'grid gap-8 md:grid-cols-12 md:gap-10 lg:gap-14',
                    i > 0 && 'border-t border-stone-300 pt-14',
                  ]}
                >
                  <div class="md:col-span-5">
                    {immagine ? (
                      <div class="media aspect-4/3">
                        <Image
                          src={immagine}
                          alt={riempi(t.altCamera, { camera: nome })}
                          widths={[420, 600, 900]}
                          sizes="(min-width: 768px) 40vw, 92vw"
                          format="webp"
                          quality={84}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : (
                      <div
                        class="segnaposto-foto aspect-4/3"
                        role="img"
                        aria-label={riempi(t.segnapostoAlt, { camera: camera.data.titolo })}
                      >
                        <span class="segnaposto-foto__titolo">{t.segnapostoTitolo}</span>
                        <span class="segnaposto-foto__soggetto">{camera.data.titolo}</span>
                      </div>
                    )}
                  </div>

                  <div class="md:col-span-7">
                    <h3 class="font-[family-name:var(--font-display)] text-2xl leading-snug text-stone-900">
                      {camera.data.titolo}
                    </h3>

                    {camera.data.occupanti && <p class="eyebrow mt-2">{camera.data.occupanti}</p>}

                    <p class="mt-4 max-w-[56ch] text-[1.0625rem] leading-relaxed text-stone-600">
                      {camera.data.descrizione}
                    </p>

                    {camera.data.servizi.length > 0 && (
                      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.875rem] text-stone-600">
                        {camera.data.servizi.map((servizio) => (
                          <li class="flex items-center gap-2">
                            <span
                              class="inline-block h-[3px] w-[3px] shrink-0 rounded-full bg-forest-500"
                              aria-hidden="true"
                            />
                            {servizio}
                          </li>
                        ))}
                      </ul>
                    )}

                    {i === 0 && (
                      <p class="mt-5 max-w-[52ch] text-[0.85rem] leading-relaxed text-stone-500">
                        {t.notaColazione}
                      </p>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ==================================================================
         Tabella tariffe
         ================================================================== -->
    <section class="section-y sezione-legno" aria-labelledby="titolo-tariffe">
      <div class="shell">
        <p class="eyebrow text-wood-500">{t.etichettaPrezzi}</p>
        <h2 id="titolo-tariffe" class="display-2 mt-4 max-w-[26ch] text-stone-900">
          {t.titoloTariffe}
        </h2>
        <span class="filo-accento filo-accento--legno" aria-hidden="true"></span>
        <p class="lede mt-6 max-w-[60ch] text-[1rem]">
          {t.ledeTariffe}
        </p>

        <div class="mt-10 overflow-x-auto">
          <table class="tariffe min-w-[34rem]">
            <caption class="sr-only">
              {t.captionTabella}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t.tabella.camera}</th>
                <th scope="col">{t.tabella.bnb}</th>
                <th scope="col">{t.tabella.mezzaPensione}</th>
                <th scope="col">{t.tabella.pensioneCompleta}</th>
              </tr>
            </thead>
            <tbody>
              {
                camere.map((camera) => (
                  <tr>
                    <th scope="row">{camera.data.titolo}</th>
                    <td class="tariffe__prezzo">{camera.data.tariffe.bnb} €</td>
                    <td class="tariffe__prezzo">{camera.data.tariffe.mezzaPensione} €</td>
                    <td class="tariffe__prezzo">{camera.data.tariffe.pensioneCompleta} €</td>
                  </tr>
                ))
              }
              <tr>
                <th scope="row">
                  {t.doppiaUsoSingola}
                  <span class="block text-[0.8rem] font-normal text-stone-500">
                    {t.supplemento}
                  </span>
                </th>
                <td colspan="3" class="tariffe__prezzo">
                  {riempi(t.valoreSupplemento, { valore: String(site.supplementoDus) })}
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="mt-6 max-w-[70ch] text-[0.875rem] leading-relaxed text-stone-500">
          {riempi(t.notaTariffe, { giorni: String(site.soggiornoMinimo) })}
        </p>
      </div>
    </section>

    <!-- Richiesta di disponibilità -->
    <RichiestaPrenotazione
      titolo={t.prenotazioneTitolo}
      descrizione={t.prenotazioneDescrizione}
      id="modulo-prenotazione-camere"
      lingua={lingua}
    />

    <!-- Politiche e servizi -->
    <section class="section-y" aria-labelledby="titolo-politiche">
      <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <p class="eyebrow text-forest-500">{t.etichettaRegole}</p>
          <h2 id="titolo-politiche" class="display-2 mt-4 max-w-[20ch] text-stone-900">
            {t.titoloRegole}
          </h2>
          <span class="filo-accento" aria-hidden="true"></span>
          <p class="mt-6 max-w-[52ch] text-[0.95rem] leading-relaxed text-stone-600">
            {t.testoRegole}
          </p>
        </div>

        <div class="md:col-span-7">
          <dl class="politica border-t border-stone-300">
            {
              politiche.map((p) => (
                <div class="contents">
                  <dt class="border-b border-stone-200 py-4">{p.voce}</dt>
                  <dd class="border-b border-stone-200 py-4 text-right">{p.valore}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Chiusura -->
    <section class="section-y-tight bg-forest-900 text-stone-200">
      <div class="shell flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="display-2 max-w-[24ch] text-stone-50">{t.chiusuraTitolo}</h2>
          <p class="mt-4 max-w-[48ch] text-[1rem] leading-relaxed text-forest-300">
            {t.chiusuraTesto}
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a href={percorsoLocalizzato('/contatti', lingua)} class="btn btn--onDark">
            {t.pulsanteScrivici}
          </a>
          <a href={site.telefonoLink} class="btn btn--onDark">{site.telefono}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
