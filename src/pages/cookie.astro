---
/**
 * Cookie Policy.
 *
 * ⚠️ DOCUMENTO DA FAR VALIDARE, come la Privacy Policy.
 *
 * Il punto centrale — e la ragione per cui questo sito non mostra un banner
 * cookie — è che NON viene impostato alcun cookie prima di un'azione esplicita
 * dell'utente. La mappa di Google è a caricamento differito proprio per questo.
 * Se un giorno si aggiungesse analytics o si caricasse la mappa da sola, questa
 * pagina e il banner diventerebbero obbligatori.
 *
 * Bilingue. L'elenco dei cookie è un DATO, non un testo: le due versioni devono
 * restare allineate, e la nota in fondo dice quale prevale se divergono.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, SITE_URL } from '../data/site';
import { linguaDaUrl, percorsoLocalizzato, type Lingua } from '../i18n';
import { testiPagina } from '../i18n/pagine';

export interface Props {
  /** Forzata dal guscio inglese, che rende questa pagina come componente. */
  lingua?: Lingua;
}

const lingua = Astro.props.lingua ?? linguaDaUrl(Astro.url);
const t = testiPagina(lingua).cookie;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${t.metaTitolo} — ${site.nome}`,
  url: `${SITE_URL}${percorsoLocalizzato('/cookie', lingua)}`,
  inLanguage: lingua === 'en' ? 'en' : 'it-IT',
  isPartOf: { '@id': `${SITE_URL}/#locanda` },
};
---

<BaseLayout
  title={t.metaTitolo}
  description={t.metaDescrizione}
  schema={schema}
  lingua={lingua}
>
  <section class="fantasia fantasia-4 border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell">
      <p class="eyebrow">{t.etichetta}</p>
      <h1 class="display-2 mt-5 max-w-[22ch] text-stone-900">{t.titolo}</h1>
      <p class="lede mt-6 max-w-[58ch]">
        {t.lede}
      </p>
    </div>
  </section>

  <section class="section-y" aria-labelledby="titolo-elenco">
    <div class="shell">
      <h2 id="titolo-elenco" class="display-2 max-w-[24ch] text-stone-900">
        {t.titoloElenco}
      </h2>

      <div class="mt-10 overflow-x-auto">
        <table class="tariffe tariffe--testo min-w-[42rem]">
          <caption class="sr-only">
            {t.captionTabella}
          </caption>
          <thead>
            <tr>
              <th scope="col">{t.tabella.voce}</th>
              <th scope="col">{t.tabella.tipo}</th>
              <th scope="col">{t.tabella.durata}</th>
            </tr>
          </thead>
          <tbody>
            {
              t.elenco.map((voce) => (
                <tr>
                  <th scope="row">
                    {voce.nome}
                    <span class="mt-1 block max-w-[46ch] text-[0.85rem] font-normal leading-relaxed text-stone-600">
                      {voce.nota}
                    </span>
                  </th>
                  <td>{voce.tipo}</td>
                  <td>{voce.durata}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-[70ch] text-[0.875rem] leading-relaxed text-stone-500">
        {t.notaElenco}
      </p>
    </div>
  </section>

  <section class="pb-[var(--spacing-section)]" aria-labelledby="titolo-gestione">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 id="titolo-gestione" class="display-2 max-w-[18ch] text-stone-900">
          {t.titoloGestione}
        </h2>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-stone-600">
          {t.testoGestione}
        </p>

        <h3 class="mt-10 font-[family-name:var(--font-display)] text-xl text-stone-900">
          {t.titoloBanner}
        </h3>
        <p class="mt-3 max-w-[62ch] text-[0.95rem] leading-relaxed text-stone-600">
          {t.testoBannerPrima} <em>{t.testoBannerCorsivo}</em> {t.testoBannerDopo}
        </p>

        <p class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
          <a href={percorsoLocalizzato('/privacy', lingua)} class="link-arrow">
            {t.linkPrivacy}
          </a>
          <a href={percorsoLocalizzato('/contatti', lingua)} class="link-arrow">
            {t.linkContatti}
          </a>
        </p>

        {
          lingua === 'en' && (
            <p class="mt-8 border-t border-stone-300 pt-5 max-w-[62ch] text-[0.8rem] leading-relaxed text-stone-500">
              {t.notaPrevalenza}
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
