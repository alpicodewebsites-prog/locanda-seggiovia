---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Segnavia from '../../components/Segnavia.astro';
import { site, SITE_URL } from '../../data/site';
import { caricaFotoSito } from '../../lib/foto-sito';
const foto = await caricaFotoSito();

const sentieri = (await getCollection('sentieri')).sort((a, b) => a.data.ordine - b.data.ordine);

/** Il significato delle sigle CAI, spiegato dove serve. */
const scalaCai = [
  { sigla: 'T', nome: 'Turistico', nota: 'Sentieri facili, adatti anche alle famiglie.' },
  { sigla: 'E', nome: 'Escursionistico', nota: 'Serve un minimo di allenamento e scarpe adatte.' },
  { sigla: 'EE', nome: 'Escursionisti esperti', nota: 'Terreno impervio, attrezzatura adeguata.' },
];

const description =
  'Sei itinerari escursionistici da Recoaro Terme: Piccole Dolomiti, Gruppo del Carega e Pasubio, con distanze, dislivelli e difficoltà CAI.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sentieri da Recoaro Terme',
  url: `${SITE_URL}/sentieri`,
  numberOfItems: sentieri.length,
  itemListElement: sentieri.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.nome,
    url: `${SITE_URL}/sentieri/${s.id}`,
  })),
};
---

<BaseLayout title="Sentieri" description={description} schema={schema}>
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Territorio e sentieri</p>
        <h1 class="display-2 mt-5 max-w-[22ch] text-stone-900">
          I sentieri cominciano dal centro del paese
        </h1>
      </div>
      <div class="md:col-span-5">
        <p class="lede text-[1rem]">
          Sei itinerari fra Piccole Dolomiti, Gruppo del Carega e Pasubio. Difficoltà dal
          turistico all'escursionistico esposto, con i dati tecnici di ciascuno.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Elenco: le stesse schede della home, con il cartello CAI
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-elenco">
    <div class="shell">
      <h2 id="titolo-elenco" class="sr-only">Elenco degli itinerari</h2>

      <ul class="grid gap-x-10 md:grid-cols-2">
        {
          sentieri.map((sentiero) => {
            // Il numero del segnavia senza il prefisso «CAI »: sul cartello si
            // stampa la cifra, come sui cartelli veri. Se il contenuto non lo
            // riporta, il cartello resta senza numero.
            const numero = sentiero.data.segnavia?.replace(/^CAI\s*/i, '').trim();

            const dati = [
              sentiero.data.distanza && { etichetta: 'Distanza', valore: sentiero.data.distanza },
              sentiero.data.dislivello && {
                etichetta: 'Dislivello',
                valore: sentiero.data.dislivello,
              },
              sentiero.data.durata && { etichetta: 'Durata', valore: sentiero.data.durata },
              { etichetta: 'Difficoltà', valore: sentiero.data.difficolta },
            ].filter(Boolean) as { etichetta: string; valore: string }[];

            return (
              <li class="scheda-sentiero">
                <a href={`/sentieri/${sentiero.id}`} class="scheda-sentiero__link">
                  <Segnavia numero={numero} nome={sentiero.data.nome} />

                  <h3 class="scheda-sentiero__nome">{sentiero.data.nome}</h3>
                  <p class="scheda-sentiero__testo">{sentiero.data.sommario}</p>

                  <dl class="scheda-sentiero__dati">
                    {dati.map((dato) => (
                      <div class="scheda-sentiero__dato">
                        <dt>{dato.etichetta}</dt>
                        <dd>{dato.valore}</dd>
                      </div>
                    ))}
                  </dl>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ==================================================================
       Scala CAI
       ================================================================== -->
  <section class="section-y-tight sezione-bosco-chiara" aria-labelledby="titolo-cai">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow text-forest-500">Difficoltà</p>
        <h2 id="titolo-cai" class="display-2 mt-4 max-w-[18ch] text-stone-900">
          Come si leggono le difficoltà
        </h2>
        <span class="filo-accento" aria-hidden="true"></span>
        <p class="mt-6 max-w-[44ch] text-[0.95rem] leading-relaxed text-stone-600">
          Le sigle sono la classificazione ufficiale del Club Alpino Italiano. Non sono
          un giudizio: dicono cosa aspettarsi dal terreno.
        </p>
      </div>

      <dl class="md:col-span-8">
        {
          scalaCai.map((voce, i) => (
            <div
              class="grid gap-1 border-t border-stone-300 py-5 sm:grid-cols-12 sm:gap-6"
            >
              <dt class="font-[family-name:var(--font-display)] text-xl text-stone-900 sm:col-span-3">
                {voce.sigla}
              </dt>
              <dd class="sm:col-span-3">
                <span class="text-[0.95rem] font-medium text-stone-800">{voce.nome}</span>
              </dd>
              <dd class="text-[0.9rem] leading-relaxed text-stone-600 sm:col-span-6">
                {voce.nota}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ==================================================================
       La montagna, in una fotografia
       ================================================================== -->
  <section class="pb-[var(--spacing-section)]" aria-labelledby="titolo-montagna">
    <div class="shell grid items-center gap-10 md:grid-cols-12 md:gap-14">
      <figure class="md:col-span-7">
        <div class="media aspect-3/2">
          <Image
            src={foto.montagne}
            alt="Le creste innevate delle Piccole Dolomiti con il tricolore, sopra Recoaro Terme"
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 56vw, 92vw"
            format="webp"
            quality={88}
            loading="lazy"
            decoding="async"
            class="object-cover!"
          />
        </div>
        <figcaption class="mt-3 text-[0.8rem] text-stone-500">
          Il gruppo delle Piccole Dolomiti sopra Recoaro Terme.
        </figcaption>
      </figure>

      <div class="md:col-span-5">
        <p class="eyebrow text-wood-500">Il territorio</p>
        <h2 id="titolo-montagna" class="display-2 mt-4 max-w-[20ch] text-stone-900">
          Un gruppo montuoso a misura d’uomo
        </h2>
        <span class="filo-accento filo-accento--legno" aria-hidden="true"></span>
        <p class="mt-6 max-w-[46ch] text-[0.95rem] leading-relaxed text-stone-600">
          Le Piccole Dolomiti non hanno l’altezza delle grandi, e è proprio questo il
          loro pregio: si cammina tutto il giorno e si torna in paese la sera. Il
          Gruppo del Carega e il Pasubio sono a pochi chilometri.
        </p>
        <p class="mt-7">
          <a href="/contatti" class="link-arrow">Chiedi un consiglio sul percorso</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Immagine di chiusura
       ================================================================== -->
  <section class="relative isolate overflow-hidden bg-stone-800">
    <Image
      src={foto.panorama}
      alt="Segnaposto grafico di creste montuose con foschia nelle valli"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={74}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-stone-900/88 to-stone-900/45"
      aria-hidden="true"
    >
    </div>

    <div class="shell py-24 text-center md:py-28">
      <h2 class="display-2 mx-auto max-w-[22ch] text-stone-50 text-shadow-hero">
        Dove si dorme, prima di partire
      </h2>
      <p
        class="mx-auto mt-6 max-w-[52ch] text-[1.0625rem] leading-relaxed text-stone-200/95"
      >
        La Locanda è in piazza a Recoaro Terme: colazione presto, consigli su misura,
        e i sentieri che cominciano fuori dalla porta.
      </p>
      <div
        class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <a href="/camere" class="btn btn--onDark">Le camere</a>
        <a href="/contatti" class="btn btn--onDark">Chiedi informazioni</a>
      </div>
    </div>
  </section>
</BaseLayout>
