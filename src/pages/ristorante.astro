---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { caricaFotoSito } from '../lib/foto-sito';
import { risolviImmagine } from '../lib/immagini';

const foto = await caricaFotoSito();
const piatti = await getCollection('menu');

/**
 * I piatti di cui esiste una fotografia. La foto si assegna dal pannello, nella
 * scheda del piatto: aggiungendone una, compare da sola in questa galleria.
 */
const piattiConFoto = piatti
  .map((piatto) => ({ piatto, immagine: risolviImmagine(piatto.data.foto) }))
  .filter((voce) => voce.immagine !== null)
  .sort((a, b) => a.piatto.data.ordine - b.piatto.data.ordine);

/** Categorie nell'ordine in cui si mangiano, non in ordine alfabetico.
 *  Ogni categoria porta un colore: serve a rendere il menù leggibile a colpo
 *  d'occhio, non a decorare. */
const categorie = [
  { chiave: 'antipasti', label: 'Antipasti', accento: 'bosco' },
  { chiave: 'primi', label: 'Primi', accento: 'legno' },
  { chiave: 'secondi', label: 'Secondi', accento: 'alba' },
  { chiave: 'dolci', label: 'Dolci', accento: 'pietra' },
] as const;

const menuPerCategoria = categorie
  .map((categoria) => ({
    ...categoria,
    piatti: piatti
      .filter((p) => p.data.categoria === categoria.chiave)
      .sort((a, b) => a.data.ordine - b.data.ordine),
  }))
  .filter((categoria) => categoria.piatti.length > 0);

const specialita = piatti
  .filter((p) => p.data.specialita)
  .sort((a, b) => a.data.ordine - b.data.ordine);

/** Se almeno un piatto ha un prezzo, la colonna dei prezzi ha senso. */
const mostraPrezzi = piatti.some((p) => typeof p.data.prezzo === 'number');

const description =
  'Cucina tradizionale alto-vicentina a Recoaro Terme: bacalà alla vicentina, sopressa fatta in casa, trota affumicata e gnocchi con la fioreta De.Co.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menù — ${site.nome}`,
  url: `${site.url}/ristorante`,
  inLanguage: 'it-IT',
  hasMenuSection: menuPerCategoria.map((categoria) => ({
    '@type': 'MenuSection',
    name: categoria.label,
    hasMenuItem: categoria.piatti.map((p) => ({
      '@type': 'MenuItem',
      name: p.data.nome,
      description: p.data.descrizione,
      ...(typeof p.data.prezzo === 'number'
        ? { offers: { '@type': 'Offer', price: p.data.prezzo, priceCurrency: 'EUR' } }
        : {}),
    })),
  })),
};
---

<BaseLayout title="Ristorante" description={description} schema={schema} ogImage="/og-default.jpg">
  <!-- ==================================================================
       Intestazione
       ================================================================== -->
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Ristorante</p>
        <h1 class="display-2 mt-5 max-w-[22ch] text-stone-900">
          La cucina di queste valli
        </h1>
        <p class="lede mt-6 max-w-[58ch]">
          Il menù segue le stagioni e le malghe, non le mode. Il bacalà arriva da una
          tradizione lunga, la sopressa si fa in casa, la trota si affumica qui.
        </p>
      </div>

      <div class="md:col-span-5 md:order-last">
        <!--
          Qui c'era la fotografia della facciata: la stessa della home e di La
          Locanda, mentre il testo parla di cucina. Fuori contesto, e ripetuta.

          Al suo posto un segnaposto DICHIARATO, che dice esattamente quale
          fotografia serve. Meglio un riquadro onesto che una fotografia che non
          c'entra: e quando arriva lo scatto della sala, si sostituisce e basta.
        -->
        <div
          class="segnaposto-foto aspect-4/3"
          role="img"
          aria-label="Fotografia in arrivo: la sala del ristorante apparecchiata"
        >
          <span class="segnaposto-foto__titolo">Foto in arrivo</span>
          <span class="segnaposto-foto__soggetto">La sala del ristorante</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Le specialità
       ================================================================== -->
  {
    specialita.length > 0 && (
      <section class="section-y bg-forest-900 text-stone-200" aria-labelledby="titolo-specialita">
        <div class="shell">
          <div class="grid gap-8 md:grid-cols-12 md:items-end">
            <div class="md:col-span-7">
              <p class="eyebrow text-glow-300">Le specialità</p>
              <h2 id="titolo-specialita" class="display-2 mt-4 max-w-[22ch] text-stone-50">
                Quello che ci identifica
              </h2>
            </div>
            <div class="md:col-span-5">
              <p class="max-w-[46ch] text-[0.95rem] leading-relaxed text-forest-300">
                Pochi piatti, sempre gli stessi, perché sono quelli che sappiamo fare.
                Il resto del menù cambia con le stagioni.
              </p>
            </div>
          </div>

          {/* Griglia 2x2: quattro specialità, nessuna cella vuota, e le foto
              della stessa larghezza così l'impaginazione resta allineata. */}
          <ul class="mt-12 grid gap-px overflow-hidden bg-stone-50/15 sm:grid-cols-2">
            {specialita.map((piatto, i) => (
              <li class="bg-forest-900 p-7 md:p-9">
                <h3 class="font-[family-name:var(--font-display)] text-xl leading-snug text-stone-50 md:text-2xl">
                  {piatto.data.nome}
                </h3>
                <p class="mt-3 max-w-[44ch] text-[0.95rem] leading-relaxed text-forest-300">
                  {piatto.data.descrizione}
                </p>
                {piatto.id.includes('gnocchi') && (
                  <p class="mt-5">
                    <a href="/gnocchi-con-la-fioreta" class="link-arrow text-glow-300">
                      La storia e la ricetta
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>

          {/* Galleria dei piatti fotografati. Le foto si assegnano dal pannello
              nella scheda di ogni piatto; qui compaiono da sole.
              `object-contain` perché gli scatti sono piccoli: ritagliarli per
              riempire il riquadro li renderebbe sfocati. */}
          {
            piattiConFoto.length > 0 && (
              <div class="mt-8 grid gap-8 sm:grid-cols-2">
                {piattiConFoto.map(({ piatto, immagine }, i) => (
                  <figure class="foto-piatto">
                    <div class="media aspect-4/3 bg-forest-700/40">
                      <Image
                        src={immagine}
                        alt={`${piatto.data.nome}, ${piatto.data.descrizione}`}
                        widths={[200, 300, 420, 640]}
                        sizes="(min-width: 640px) 44vw, 92vw"
                        format="webp"
                        quality={86}
                        loading="lazy"
                        decoding="async"
                        class="object-contain!"
                      />
                    </div>
                    <figcaption class="mt-3 text-[0.8rem] text-forest-300">
                      {piatto.data.nome}
                    </figcaption>
                  </figure>
                ))}
              </div>
            )
          }
        </div>
      </section>
    )
  }

  <!-- ==================================================================
       Il menù
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-menu">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4">
        <h2 id="titolo-menu" class="display-2 text-stone-900">Il menù</h2>
        <p class="mt-5 max-w-[44ch] text-[0.95rem] leading-relaxed text-stone-600">
          Il menù cambia con le stagioni e con quello che le malghe hanno da offrire.
          Questi sono i piatti che trovate tutto l'anno.
        </p>
        {
          !mostraPrezzi && (
            <p class="mt-5 max-w-[44ch] text-[0.875rem] leading-relaxed text-stone-500">
              I prezzi non sono ancora pubblicati: chiediceli direttamente, oppure
              consultali in locanda.
            </p>
          )
        }
      </div>

      <div class="md:col-span-8">
        {
          menuPerCategoria.map((categoria) => (
            <section class="mb-12 last:mb-0" aria-labelledby={`cat-${categoria.chiave}`}>
              <h3
                id={`cat-${categoria.chiave}`}
                class:list={['eyebrow cat-menu', `cat-menu--${categoria.accento}`]}
              >
                {categoria.label}
              </h3>

              <ul class="mt-2">
                {categoria.piatti.map((piatto) => (
                  <li
                    class:list={['border-b border-stone-200 py-5 last:border-b-0 card-accento', `card-accento--${categoria.accento}`]}
                  >
                    <div class="piatto">
                      <h4 class="font-[family-name:var(--font-display)] text-lg leading-snug text-stone-900">
                        {piatto.data.nome}
                      </h4>
                      <span class="piatto__fila" aria-hidden="true" />
                      {typeof piatto.data.prezzo === 'number' && (
                        <span class="piatto__prezzo text-stone-800">{piatto.data.prezzo} €</span>
                      )}
                    </div>
                    <p class="mt-2 max-w-[58ch] text-[0.95rem] leading-relaxed text-stone-600">
                      {piatto.data.descrizione}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ==================================================================
       Orari e prenotazioni
       ================================================================== -->
  <section class="section-y-tight bg-stone-50" aria-labelledby="titolo-orari">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 id="titolo-orari" class="display-2 text-stone-900">Orari e prenotazioni</h2>
        <p class="mt-5 max-w-[46ch] text-[0.95rem] leading-relaxed text-stone-600">
          Il tavolo si prenota per tempo, soprattutto nei fine settimana e in stagione.
          Per gruppi e per esigenze particolari, chiamateci.
        </p>
      </div>

      <div class="md:col-span-4">
        <dl class="border-t border-stone-300">
          {
            site.orari.map((riga) => (
              <div class="contents">
                <dt class="border-b border-stone-200 py-4 text-[0.875rem] text-stone-500">
                  {riga.giorno}
                </dt>
                <dd class="border-b border-stone-200 py-4 font-medium text-stone-800">
                  {riga.valore}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="flex flex-col gap-3 md:col-span-3 md:items-end">
        <a href="/contatti" class="btn btn--primary w-full sm:w-auto">Prenota un tavolo</a>
        <a href={site.telefonoLink} class="btn btn--ghost w-full sm:w-auto">
          {site.telefono}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Fotografie dei piatti — risposta al passaggio del mouse.

    Un ingrandimento di appena il 3% in 250 ms: si percepisce che la fotografia
    è viva senza che l'immagine sembri muoversi. Il contenitore ha già
    l'`aspect-ratio` bloccato, quindi il riquadro non cambia dimensione e nulla
    si sposta attorno.

    Le figure non sono collegamenti e non mostrano il puntatore a mano: qui non
    c'è niente da aprire, e far credere il contrario sarebbe scorretto.
  */
  .foto-piatto :global(.media) {
    overflow: hidden;
  }

  .foto-piatto :global(img) {
    transition: transform 250ms ease-out;
  }

  .foto-piatto:hover :global(img) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .foto-piatto :global(img) {
      transition: none;
    }

    .foto-piatto:hover :global(img) {
      transform: none;
    }
  }
</style>
