---
/**
 * Privacy Policy.
 *
 * ⚠️ DOCUMENTO DA FAR VALIDARE. Questo è un testo base, scritto per descrivere
 * con onestà i trattamenti che il sito effettivamente effettua. Non sostituisce
 * il parere di un consulente privacy: prima della pubblicazione va riletto e
 * completato con i dati societari reali.
 *
 * I dati mancanti sono mostrati come segnaposto evidenti, invece di essere
 * inventati.
 *
 * Bilingue. La versione inglese è una traduzione, e lo dice in fondo: per un
 * testo legale serve sapere quale versione prevale se le due divergono.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, indirizzoBreve, SITE_URL } from '../data/site';
import { linguaDaUrl, percorsoLocalizzato, type Lingua } from '../i18n';
import { testiPagina } from '../i18n/pagine';

export interface Props {
  /** Forzata dal guscio inglese, che rende questa pagina come componente. */
  lingua?: Lingua;
}

const lingua = Astro.props.lingua ?? linguaDaUrl(Astro.url);
const t = testiPagina(lingua).privacy;

/** Voci che devono essere confermate prima della pubblicazione. */
const datiDaConfermare = [
  { voce: t.vociTitolare.ragioneSociale, valore: site.fiscale.ragioneSociale, confermato: false },
  {
    voce: t.vociTitolare.partitaIva,
    valore: `${site.fiscale.partitaIva} — ${site.fiscale.codiceFiscale}`,
    confermato: false,
  },
  { voce: t.vociTitolare.sedeLegale, valore: indirizzoBreve, confermato: true },
  { voce: t.vociTitolare.recapito, valore: site.email, confermato: true },
  {
    voce: t.vociTitolare.titolare,
    valore: `${site.gestione} — ${site.gestori}`,
    confermato: true,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${t.metaTitolo} — ${site.nome}`,
  url: `${SITE_URL}${percorsoLocalizzato('/privacy', lingua)}`,
  inLanguage: lingua === 'en' ? 'en' : 'it-IT',
  isPartOf: { '@id': `${SITE_URL}/#locanda` },
};
---

<BaseLayout
  title={t.metaTitolo}
  description={t.metaDescrizione}
  schema={schema}
  lingua={lingua}
>
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell">
      <p class="eyebrow">{t.etichetta}</p>
      <h1 class="display-2 mt-5 max-w-[22ch] text-stone-900">{t.titolo}</h1>
      <p class="lede mt-6 max-w-[58ch]">
        {t.lede}
      </p>
    </div>
  </section>

  <!-- Avviso: documento da validare -->
  <section class="pt-12">
    <div class="shell">
      <p
        class="border-l-4 border-glow-500 bg-glow-300/20 px-5 py-4 text-[0.9rem] leading-relaxed text-stone-700"
        role="note"
      >
        <strong class="font-medium">{t.avvisoTitolo}</strong>
        {t.avvisoTesto}
      </p>
    </div>
  </section>

  <!-- Titolare -->
  <section class="pt-14 pb-12" aria-labelledby="titolo-titolare">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 id="titolo-titolare" class="display-2 text-stone-900">{t.titoloTitolare}</h2>
      </div>
      <div class="md:col-span-8">
        <dl class="border-t border-stone-300">
          {
            datiDaConfermare.map((riga) => (
              <div class="spec">
                <dt class="spec__key">{riga.voce}</dt>
                <dd class="spec__val text-stone-800">
                  {riga.confermato ? (
                    riga.valore
                  ) : (
                    <span class="text-glow-500">
                      {riga.valore} <span class="text-[0.8rem]">{t.daConfermare}</span>
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Trattamenti -->
  <section class="pb-12" aria-labelledby="titolo-trattamenti">
    <div class="shell">
      <h2 id="titolo-trattamenti" class="display-2 max-w-[24ch] text-stone-900">
        {t.titoloTrattamenti}
      </h2>

      <div class="mt-10 space-y-10">
        {
          t.trattamenti.map((trattamento) => (
            <article class="border-t border-stone-300 pt-8">
              <h3 class="font-[family-name:var(--font-display)] text-2xl leading-snug text-stone-900">
                {trattamento.nome}
              </h3>
              <dl class="mt-6 grid gap-x-10 gap-y-5 sm:grid-cols-2">
                <div>
                  <dt class="text-[0.8rem] tracking-[0.1em] text-stone-500 uppercase">
                    {t.campi.finalita}
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-stone-700">
                    {trattamento.finalita}
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.8rem] tracking-[0.1em] text-stone-500 uppercase">
                    {t.campi.dati}
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-stone-700">
                    {trattamento.dati}
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.8rem] tracking-[0.1em] text-stone-500 uppercase">
                    {t.campi.base}
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-stone-700">
                    {trattamento.base}
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.8rem] tracking-[0.1em] text-stone-500 uppercase">
                    {t.campi.conservazione}
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-stone-700">
                    {trattamento.conservazione}
                  </dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="text-[0.8rem] tracking-[0.1em] text-stone-500 uppercase">
                    {t.campi.destinatari}
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-stone-700">
                    {trattamento.destinatari}
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Diritti -->
  <section class="pb-[var(--spacing-section)]" aria-labelledby="titolo-diritti">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 id="titolo-diritti" class="display-2 max-w-[18ch] text-stone-900">{t.titoloDiritti}</h2>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed text-stone-600">
          {t.testoDirittiPrima}
          <a href={`mailto:${site.email}`} class="link-arrow ml-1">{site.email}</a>{t.testoDirittiDopo}
        </p>
        <p class="mt-5 max-w-[62ch] text-[1.0625rem] leading-relaxed text-stone-600">
          {t.testoGarantePrima}
          (<a
            href="https://www.garanteprivacy.it"
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow">garanteprivacy.it</a
          >){t.testoGaranteDopo}
        </p>

        <h3 class="mt-10 font-[family-name:var(--font-display)] text-xl text-stone-900">
          {t.titoloTrasferimenti}
        </h3>
        <p class="mt-3 max-w-[62ch] text-[0.95rem] leading-relaxed text-stone-600">
          {t.testoTrasferimenti}
        </p>

        <h3 class="mt-10 font-[family-name:var(--font-display)] text-xl text-stone-900">
          {t.titoloModifiche}
        </h3>
        <p class="mt-3 max-w-[62ch] text-[0.95rem] leading-relaxed text-stone-600">
          {t.testoModifiche}
        </p>

        <p class="mt-10">
          <a href={percorsoLocalizzato('/cookie', lingua)} class="link-arrow">{t.linkCookie}</a>
        </p>

        {/*
          La nota sulla versione che prevale compare SOLO in inglese: è una
          precisazione per chi legge la traduzione. Sulla pagina italiana
          sarebbe rumore.
        */}
        {
          lingua === 'en' && (
            <p class="mt-8 border-t border-stone-300 pt-5 max-w-[62ch] text-[0.8rem] leading-relaxed text-stone-500">
              {t.notaPrevalenza}
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
