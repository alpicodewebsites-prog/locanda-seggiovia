---
/**
 * La Locanda — storia e famiglia.
 *
 * Nota sui contenuti: l'anno di fondazione non è confermato, quindi la pagina
 * NON lo cita. Racconta la famiglia, il rapporto con la montagna e la scelta di
 * essere un rifugio invece di un albergo: cose vere, ricavate dal posizionamento
 * del progetto, senza inventare date né riconoscimenti.
 *
 * Bilingue: i testi stanno in `src/i18n/pagine.ts`, i contenuti modificabili in
 * `src/content/la-locanda/` (uno per lingua), le fotografie restano comuni.
 */
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import { site, mappaLinkUrl } from '../data/site';
import { caricaLocanda } from '../lib/pagine';
import { linguaDaUrl, percorsoLocalizzato, riempi, type Lingua } from '../i18n';
import { testiPagina } from '../i18n/pagine';
import imgLogo from '../assets/locanda-logo.png';

export interface Props {
  /** Forzata dal guscio inglese, che rende questa pagina come componente. */
  lingua?: Lingua;
}

const lingua = Astro.props.lingua ?? linguaDaUrl(Astro.url);
const t = testiPagina(lingua).locanda;

/** I dati della struttura nella lingua giusta. */
const gestori = lingua === 'en' ? site.gestoriEn : site.gestori;

// Testi e fotografie della pagina, modificabili dal pannello.
const pagina = await caricaLocanda(lingua);
const foto = pagina.foto;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t.metaTitolo,
  url: `${site.url}${percorsoLocalizzato('/la-locanda', lingua)}`,
  inLanguage: lingua === 'en' ? 'en' : 'it-IT',
  mainEntity: { '@id': `${site.url}/#locanda` },
};
---

<BaseLayout
  title={t.metaTitolo}
  description={t.metaDescrizione}
  schema={schema}
  lingua={lingua}
>
  <!-- ==================================================================
       Apertura
       ================================================================== -->
  <section class="border-b border-stone-200 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell">
      <p class="eyebrow">{t.etichetta}</p>
      <h1 class="display-2 mt-5 max-w-[24ch] text-stone-900">
        {pagina.testi.titolo || t.titolo}
      </h1>
      <p class="lede mt-6 max-w-[58ch]">
        {pagina.testi.sottotitolo || t.lede}
      </p>
    </div>
  </section>

  <!-- ==================================================================
       Storia
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-storia">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10 lg:gap-16">
      <div class="md:col-span-5 md:order-2">
        <div class="media aspect-3/4">
          <Image
            src={foto.cucina}
            alt={t.altCucina}
            widths={[300, 420, 640]}
            sizes="(min-width: 768px) 40vw, 92vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="mt-3 text-[0.8rem] text-stone-500">
          {t.didascaliaCucina}
        </p>
      </div>

      <div class="md:col-span-7 md:order-1">
        <h2 id="titolo-storia" class="display-2 max-w-[20ch] text-stone-900">
          {riempi(t.titoloFamiglia, { cognome: site.cognome })}
        </h2>

        <div class="prose-body mt-7 max-w-[62ch] text-[1.0625rem] text-stone-600">
          {
            t.paragrafiFamiglia.map((paragrafo) => (
              <p>{riempi(paragrafo, { gestori })}</p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Che cosa la rende un rifugio
       ================================================================== -->
  <section class="section-y sezione-bosco-chiara" aria-labelledby="titolo-rifugio">
    <div class="shell">
      <p class="eyebrow text-forest-500">{t.etichettaCarattere}</p>
      <h2 id="titolo-rifugio" class="display-2 mt-4 max-w-[24ch] text-stone-900">
        {t.titoloCarattere}
      </h2>
      <span class="filo-accento" aria-hidden="true"></span>

      <div class="prose-body mt-8 max-w-[64ch] space-y-5 text-[1.0625rem] text-stone-600">
        {t.carattere.map((paragrafo) => <p>{paragrafo}</p>)}
      </div>
    </div>
  </section>

  <!-- ==================================================================
       La struttura
       ------------------------------------------------------------------
       Era nella pagina Camere, dove non apparteneva: quel testo parla
       dell'edificio, non delle camere. Qui sta al suo posto — è la casa,
       ed è quello che questa pagina racconta.
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-struttura">
    <div class="shell grid gap-10 md:grid-cols-12 md:gap-12 md:items-center">
      <figure class="media aspect-4/3 md:col-span-6">
        <Image
          src={foto.facciata}
          alt={t.altFacciata}
          widths={[420, 600, 900]}
          sizes="(min-width: 768px) 48vw, 92vw"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="md:col-span-6">
        <p class="eyebrow text-wood-500">{t.etichettaCasa}</p>
        <h2 id="titolo-struttura" class="display-2 mt-4 max-w-[20ch] text-stone-900">
          {t.titoloCasa}
        </h2>
        <span class="filo-accento filo-accento--legno" aria-hidden="true"></span>

        <div class="prose-body mt-7 max-w-[52ch] space-y-5 text-[1.0625rem] text-stone-600">
          {t.paragrafiCasa.map((paragrafo) => <p>{paragrafo}</p>)}
          <p class="text-[0.9rem] text-stone-500">
            {t.notaFoto}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Dove siamo
       ================================================================== -->
  <section class="section-y" aria-labelledby="titolo-dove">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <h2 id="titolo-dove" class="display-2 max-w-[18ch] text-stone-900">
          {t.titoloDove}
        </h2>
        <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-stone-600">
          {t.testoDove}
        </p>
        <p class="mt-8">
          <a
            href={mappaLinkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow"
          >
            {t.apriMappa}
          </a>
        </p>
      </div>

      <div class="md:col-span-7">
        <dl class="border-t border-stone-300">
          <div class="spec">
            <dt class="spec__key">{t.voci.indirizzo}</dt>
            <dd class="spec__val text-stone-800">
              {site.indirizzo.via}, {site.indirizzo.citta}
            </dd>
          </div>
          <div class="spec">
            <dt class="spec__key">{t.voci.altitudine}</dt>
            <dd class="spec__val text-stone-800">{t.altitudine}</dd>
          </div>
          <div class="spec">
            <dt class="spec__key">{t.voci.gruppi}</dt>
            <dd class="spec__val text-stone-800">{t.gruppi}</dd>
          </div>
          <div class="spec">
            <dt class="spec__key">{t.voci.camere}</dt>
            <dd class="spec__val text-stone-800">
              <a href={percorsoLocalizzato('/camere', lingua)} class="link-arrow">
                {t.camereLink}
              </a>
            </dd>
          </div>
          <div class="spec">
            <dt class="spec__key">{t.voci.ristorante}</dt>
            <dd class="spec__val text-stone-800">
              <a href={percorsoLocalizzato('/ristorante', lingua)} class="link-arrow">
                {t.ristoranteLink}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Chiusura
       ================================================================== -->
  <section class="section-y-tight bg-forest-900 text-stone-200">
    <div class="shell flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="display-2 max-w-[22ch] text-stone-50">{t.titoloChiusura}</h2>
        <p class="mt-4 max-w-[48ch] text-[1rem] leading-relaxed text-forest-300">
          {t.testoChiusura}
        </p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href={percorsoLocalizzato('/camere', lingua)} class="btn btn--onDark">
          {t.pulsanteCamere}
        </a>
        <a href={percorsoLocalizzato('/contatti', lingua)} class="btn btn--onDark">
          {t.pulsanteContatti}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
