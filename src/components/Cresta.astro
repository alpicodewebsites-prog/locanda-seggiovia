---
/**
 * Cresta — elemento grafico a tema.
 *
 * Un profilo di montagna disegnato in linea, usato per riempire gli spazi
 * vuoti e dare ritmo fra una sezione e l'altra. Riprende la forma del favicon,
 * quindi è coerente con l'identità e non è decorazione fine a se stessa:
 * ricorda dove si trova la locanda.
 *
 * È puramente decorativo: `aria-hidden`, nessun testo alternativo.
 */
export interface Props {
  /** Colore del tratto e del riempimento tenue. */
  accento?: 'bosco' | 'legno' | 'alba' | 'pietra';
  /** Altezza in pixel. */
  altezza?: number;
}

const { accento = 'pietra', altezza = 48 } = Astro.props;
---

<div
  class:list={['cresta', `cresta--${accento}`]}
  style={`--cresta-h: ${altezza}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 240 48" preserveAspectRatio="none" focusable="false">
    <!-- Due cime, la seconda più alta: la stessa forma del favicon. -->
    <path d="M0 40 L34 14 L56 30 L92 4 L124 28 L150 12 L178 32 L206 18 L240 38" />
  </svg>
</div>

<style>
  .cresta {
    width: 100%;
    height: var(--cresta-h);
    color: var(--cresta-colore, var(--color-acc-pietra));
    overflow: hidden;
    /* Non ruba spazio al contenuto: è una pausa, non una sezione. */
    pointer-events: none;
  }

  .cresta svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cresta path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.5;
  }

  .cresta--bosco {
    --cresta-colore: var(--color-acc-bosco);
  }
  .cresta--legno {
    --cresta-colore: var(--color-acc-legno);
  }
  .cresta--alba {
    --cresta-colore: var(--color-acc-alba);
  }
  .cresta--pietra {
    --cresta-colore: var(--color-acc-pietra);
  }
</style>
