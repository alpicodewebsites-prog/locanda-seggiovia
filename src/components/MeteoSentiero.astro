---
/**
 * MeteoSentiero — il meteo di un punto preciso, aggiornato dal browser.
 *
 * ----------------------------------------------------------------------------
 * PERCHÉ SI CARICA DAL BROWSER E NON DURANTE LA COMPILAZIONE
 *
 * Il sito è statico: potrebbe interrogare il meteo una volta sola, quando si
 * compila, e scrivere il risultato nell'HTML. Sarebbe più semplice e più veloce
 * — ma il dato invecchierebbe: il sito si ricompila quando qualcuno modifica un
 * contenuto, non ogni ora. Un meteo di tre giorni fa è peggio di nessun meteo.
 *
 * ----------------------------------------------------------------------------
 * LO SFONDO CAMBIA CON IL TEMPO
 *
 * Il riquadro prende il colore del cielo che sta descrivendo: oro caldo col
 * sereno, grigio di nebbia quando c'è nebbia, strisce oblique quando piove,
 * punti chiari quando nevica.
 *
 * È fatto con gradienti e non con fotografie, e la scelta è voluta:
 *   - pesa zero byte, e questa scheda ne ha già abbastanza
 *   - non dipende da una licenza né da una risoluzione
 *   - il colore è esattamente quello che serve perché il testo resti leggibile;
 *     con una fotografia il contrasto cambierebbe da punto a punto
 *
 * Gli sfondi sono tutti CHIARI: il testo resta scuro su ogni condizione, quindi
 * il contrasto non dipende da cosa c'è dietro. Anche il cielo più scuro resta
 * sopra 6:1, ben oltre i 4,5:1 richiesti.
 *
 * ----------------------------------------------------------------------------
 * IL PUNTO CHE SI MISURA
 *
 * Le coordinate NON sono «del sentiero»: un sentiero è lungo chilometri e la
 * temperatura cambia con la quota. Sono quelle di un punto preciso, di solito il
 * parcheggio di partenza. `localita` lo dice a parole.
 *
 * ----------------------------------------------------------------------------
 * ACCESSIBILITÀ
 *
 *  - Nessuna live region: annuncerebbe tutto il meteo all'apertura della pagina.
 *  - Se il caricamento fallisce resta un messaggio leggibile e un collegamento a
 *    un bollettino vero.
 *  - Nessuna animazione, quindi niente da disattivare con `prefers-reduced-motion`.
 * ----------------------------------------------------------------------------
 */
export interface Props {
  /** Latitudine del punto in cui si misura il meteo. */
  latitudine: number;
  /** Longitudine del punto in cui si misura il meteo. */
  longitudine: number;
  /** Il luogo, a parole: si mostra accanto ai dati. */
  localita: string;
  /** Quota del punto, in metri. Facoltativa. */
  quota?: number;
}

const { latitudine, longitudine, localita, quota } = Astro.props;
---

<div
  class="meteo"
  data-meteo
  data-lat={latitudine}
  data-lon={longitudine}
  data-luogo={localita}
>
  <div class="meteo__testa">
    <p class="meteo__etichetta">Meteo</p>
    <p class="meteo__luogo">
      {localita}{quota && <span class="meteo__quota"> · {quota} m</span>}
    </p>
  </div>

  <div class="meteo__corpo" data-meteo-corpo aria-busy="true">
    <p class="meteo__attesa">Caricamento del meteo…</p>
  </div>

  <p class="meteo__fonte">
    Dati <a href="https://open-meteo.com/" rel="noopener" target="_blank">Open-Meteo</a>,
    aggiornati a ogni apertura della pagina.
  </p>

  <noscript>
    <p class="meteo__fonte">
      Il meteo si carica con JavaScript attivo. Senza, resta il
      <a href="https://www.ilmeteo.it/meteo/Recoaro+Terme">bollettino di Recoaro Terme</a>.
    </p>
  </noscript>
</div>

<style is:global>
  /*
    ATTENZIONE — `is:global` non è pigrizia, è necessario.

    Astro "isola" gli stili aggiungendo un attributo agli elementi scritti nel
    modello. Ma il contenuto di questo riquadro viene creato DOPO, da
    JavaScript: quei elementi non hanno l'attributo, quindi le regole con scopo
    non li raggiungono e il riquadro resta senza stile.

    Si può scrivere tutto globale perché ogni classe comincia con `meteo`.
  */
  .meteo {
    --testo-meteo: #1c1b19;
    /* Testi secondari: un grigio pieno, non un nero trasparente. */
    --testo-meteo-2: #3a3a35;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem 1.4rem 1.15rem;
    overflow: hidden;
    border-radius: var(--raggio-card);
    color: var(--testo-meteo);
    /* Ripiego prima del caricamento: cielo coperto, neutro. */
    background-color: #ddd9d2;
    background-image: linear-gradient(160deg, #e6e2db, #cbc7bf);
  }

  /* --- I cieli ---------------------------------------------------------
     Tutti chiari: il testo scuro resta leggibile su ogni condizione, e il
     contrasto non dipende da dove cade il testo.
  */
  .meteo[data-cielo='sereno'] {
    background-color: #ecd9ac;
    background-image:
      radial-gradient(circle at 82% 12%, rgba(255, 250, 232, 0.95) 0%, rgba(255, 246, 214, 0) 46%),
      linear-gradient(160deg, #f6ecd4, #e5cfa0);
  }

  .meteo[data-cielo='poco-nuvoloso'] {
    background-color: #e2ddd1;
    background-image:
      radial-gradient(circle at 80% 10%, rgba(255, 249, 232, 0.8) 0%, rgba(255, 249, 232, 0) 40%),
      linear-gradient(160deg, #f0ebe0, #d6d0c2);
  }

  .meteo[data-cielo='nuvoloso'] {
    background-color: #cfccc4;
    background-image:
      repeating-linear-gradient(168deg, rgba(255, 255, 255, 0.28) 0 2px, transparent 2px 18px),
      linear-gradient(160deg, #dedad3, #bdbab2);
  }

  .meteo[data-cielo='nebbia'] {
    background-color: #d2d2cc;
    background-image:
      repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.42) 0 14px, transparent 14px 34px),
      linear-gradient(180deg, #e6e5e0, #c6c6c0);
  }

  .meteo[data-cielo='pioggia'] {
    background-color: #bfc5c6;
    background-image:
      repeating-linear-gradient(104deg, rgba(255, 255, 255, 0.38) 0 1px, transparent 1px 8px),
      linear-gradient(160deg, #ccd1d2, #aab0b2);
  }

  .meteo[data-cielo='rovesci'] {
    background-color: #b9bfc0;
    background-image:
      repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.5) 0 1px, transparent 1px 6px),
      linear-gradient(160deg, #cfd4d5, #a6acae);
  }

  .meteo[data-cielo='neve'] {
    background-color: #e4e8e8;
    background-image:
      radial-gradient(circle at 18% 26%, rgba(255, 255, 255, 0.95) 0 1.5px, transparent 2px),
      radial-gradient(circle at 62% 48%, rgba(255, 255, 255, 0.95) 0 1.5px, transparent 2px),
      radial-gradient(circle at 40% 74%, rgba(255, 255, 255, 0.9) 0 1.5px, transparent 2px),
      radial-gradient(circle at 84% 18%, rgba(255, 255, 255, 0.9) 0 1.5px, transparent 2px),
      linear-gradient(160deg, #f1f4f4, #d8dede);
  }

  .meteo[data-cielo='temporale'] {
    background-color: #a6a8a2;
    background-image:
      linear-gradient(118deg, transparent 42%, rgba(255, 252, 236, 0.7) 47%, transparent 53%),
      repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.3) 0 1px, transparent 1px 7px),
      linear-gradient(160deg, #c4c6bf, #aaaca5);
  }

  .meteo__testa {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .meteo__etichetta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--testo-meteo-2);
  }

  .meteo__luogo {
    font-size: 0.875rem;
    color: var(--testo-meteo-2);
  }

  .meteo__quota {
    font-variant-numeric: tabular-nums;
  }

  .meteo__attesa {
    font-size: 0.95rem;
    color: var(--testo-meteo-2);
  }

  /* --- Adesso ---------------------------------------------------------- */
  .meteo__adesso {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.9rem;
  }

  .meteo__gradi {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 3.4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .meteo__condizione {
    font-size: 1rem;
    color: var(--testo-meteo);
  }

  /* --- I dati di oggi -------------------------------------------------- */
  .meteo__dati {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.75rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .meteo__dati div {
    display: flex;
    gap: 0.4rem;
  }

  .meteo__dati dt {
    color: var(--testo-meteo-2);
  }

  .meteo__dati dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* --- I prossimi giorni ----------------------------------------------- */
  .meteo__giorni {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--testo-meteo) 20%, transparent);
    list-style: none;
  }

  .meteo__giorno {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--testo-meteo-2);
  }

  .meteo__valori {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .meteo__vento {
    display: block;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--testo-meteo-2);
  }

  .meteo__fonte {
    position: relative;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--testo-meteo-2);
  }

  .meteo__fonte a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .meteo__fonte a:focus-visible {
    outline: 2px solid var(--testo-meteo);
    outline-offset: 2px;
  }
</style>

<script>
  /*
    Codici meteo WMO → parole italiane, e → cielo da disegnare.
    Open-Meteo restituisce un numero; senza questa tabella il riquadro
    mostrerebbe «61», che non dice niente a nessuno.
  */
  const CONDIZIONI: Record<number, { testo: string; cielo: string }> = {
    0: { testo: 'Sereno', cielo: 'sereno' },
    1: { testo: 'Prevalentemente sereno', cielo: 'sereno' },
    2: { testo: 'Parzialmente nuvoloso', cielo: 'poco-nuvoloso' },
    3: { testo: 'Nuvoloso', cielo: 'nuvoloso' },
    45: { testo: 'Nebbia', cielo: 'nebbia' },
    48: { testo: 'Nebbia con brina', cielo: 'nebbia' },
    51: { testo: 'Pioviggine debole', cielo: 'pioggia' },
    53: { testo: 'Pioviggine moderata', cielo: 'pioggia' },
    55: { testo: 'Pioviggine intensa', cielo: 'pioggia' },
    56: { testo: 'Pioviggine gelata', cielo: 'pioggia' },
    57: { testo: 'Pioviggine gelata intensa', cielo: 'pioggia' },
    61: { testo: 'Pioggia debole', cielo: 'pioggia' },
    63: { testo: 'Pioggia moderata', cielo: 'pioggia' },
    65: { testo: 'Pioggia forte', cielo: 'pioggia' },
    66: { testo: 'Pioggia gelata', cielo: 'pioggia' },
    67: { testo: 'Pioggia gelata forte', cielo: 'pioggia' },
    71: { testo: 'Neve debole', cielo: 'neve' },
    73: { testo: 'Neve moderata', cielo: 'neve' },
    75: { testo: 'Neve forte', cielo: 'neve' },
    77: { testo: 'Granelli di neve', cielo: 'neve' },
    80: { testo: 'Rovesci deboli', cielo: 'rovesci' },
    81: { testo: 'Rovesci moderati', cielo: 'rovesci' },
    82: { testo: 'Rovesci forti', cielo: 'rovesci' },
    85: { testo: 'Rovesci di neve', cielo: 'neve' },
    86: { testo: 'Rovesci di neve forti', cielo: 'neve' },
    95: { testo: 'Temporale', cielo: 'temporale' },
    96: { testo: 'Temporale con grandine', cielo: 'temporale' },
    99: { testo: 'Temporale con grandine forte', cielo: 'temporale' },
  };

  /** Un codice sconosciuto non deve diventare «undefined» in pagina. */
  function condizione(codice: number) {
    return CONDIZIONI[codice] ?? { testo: 'Condizioni variabili', cielo: 'nuvoloso' };
  }

  const GIORNI = ['domenica', 'lunedì', 'martedì', 'mercoledì', 'giovedì', 'venerdì', 'sabato'];

  /** «Oggi», «Domani», poi il nome del giorno. */
  function etichettaGiorno(indice: number, data: string): string {
    if (indice === 0) return 'Oggi';
    if (indice === 1) return 'Domani';
    const d = new Date(`${data}T12:00:00`);
    return GIORNI[d.getDay()] ?? data;
  }

  function gradi(valore: number): string {
    return `${Math.round(valore)}°`;
  }

  /** Dipinge il cielo del riquadro secondo la condizione. */
  function dipingiCielo(el: HTMLElement, codice: number) {
    el.dataset.cielo = condizione(codice).cielo;
  }

  /** Il riquadro quando il meteo non arriva: niente spazio vuoto. */
  function mostraErrore(el: HTMLElement, corpo: HTMLElement) {
    el.dataset.cielo = 'nuvoloso';
    corpo.setAttribute('aria-busy', 'false');
    corpo.innerHTML =
      '<p class="meteo__attesa">Il meteo non è disponibile in questo momento. ' +
      'Riprova più tardi, oppure consulta il ' +
      '<a href="https://www.ilmeteo.it/meteo/Recoaro+Terme" rel="noopener" target="_blank">' +
      'bollettino di Recoaro Terme</a>.</p>';
  }

  type Risposta = {
    current: { temperature_2m: number; weather_code: number; wind_speed_10m: number };
    daily: {
      time: string[];
      temperature_2m_max: number[];
      temperature_2m_min: number[];
      weather_code: number[];
      precipitation_probability_max: (number | null)[];
    };
  };

  function disegna(el: HTMLElement, corpo: HTMLElement, d: Risposta) {
    const oggi = d.daily;
    const giorni = oggi.time.slice(0, 3).map((data, i) => {
      const pioggia = oggi.precipitation_probability_max?.[i];
      return `
        <li>
          <span class="meteo__giorno">${etichettaGiorno(i, data)}</span>
          <span class="meteo__valori">${gradi(oggi.temperature_2m_max[i])} / ${gradi(oggi.temperature_2m_min[i])}</span>
          <span class="meteo__vento">${condizione(oggi.weather_code[i]).testo}${
            typeof pioggia === 'number' ? ` · ${pioggia}%` : ''
          }</span>
        </li>`;
    });

    dipingiCielo(el, d.current.weather_code);
    corpo.setAttribute('aria-busy', 'false');
    corpo.innerHTML = `
      <div class="meteo__adesso">
        <span class="meteo__gradi">${gradi(d.current.temperature_2m)}</span>
        <span class="meteo__condizione">${condizione(d.current.weather_code).testo}</span>
      </div>
      <dl class="meteo__dati">
        <div>
          <dt>Oggi</dt>
          <dd>${gradi(oggi.temperature_2m_max[0])} / ${gradi(oggi.temperature_2m_min[0])}</dd>
        </div>
        <div>
          <dt>Vento</dt>
          <dd>${Math.round(d.current.wind_speed_10m)} km/h</dd>
        </div>
      </dl>
      <ul class="meteo__giorni">${giorni.join('')}</ul>`;
  }

  /*
    La memoria della scheda: se si torna sulla pagina dopo poco, i dati si
    riusano invece di richiederli di nuovo. Quindici minuti è il passo con cui
    Open-Meteo aggiorna le previsioni.
  */
  const DURATA_MEMORIA = 15 * 60 * 1000;

  function chiave(lat: string, lon: string) {
    return `meteo:${lat},${lon}`;
  }

  function leggiMemoria(lat: string, lon: string): Risposta | null {
    try {
      const grezzo = sessionStorage.getItem(chiave(lat, lon));
      if (!grezzo) return null;
      const { quando, dati } = JSON.parse(grezzo);
      if (Date.now() - quando > DURATA_MEMORIA) return null;
      return dati;
    } catch {
      return null;
    }
  }

  function scriviMemoria(lat: string, lon: string, dati: Risposta) {
    try {
      sessionStorage.setItem(chiave(lat, lon), JSON.stringify({ quando: Date.now(), dati }));
    } catch {
      /* Spazio pieno o memoria disattivata: non è un problema, si richiede. */
    }
  }

  async function carica(el: HTMLElement) {
    const lat = el.dataset.lat;
    const lon = el.dataset.lon;
    const corpo = el.querySelector<HTMLElement>('[data-meteo-corpo]');
    if (!lat || !lon || !corpo) return;

    const memorizzato = leggiMemoria(lat, lon);
    if (memorizzato) {
      disegna(el, corpo, memorizzato);
      return;
    }

    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
      '&current=temperature_2m,weather_code,wind_speed_10m' +
      '&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max' +
      '&timezone=Europe%2FRome&forecast_days=3';

    try {
      // Se il servizio non risponde entro dieci secondi si smette di aspettare:
      // il riquadro deve dire qualcosa, non restare in caricamento.
      const controllo = new AbortController();
      const scadenza = setTimeout(() => controllo.abort(), 10_000);

      const risposta = await fetch(url, { signal: controllo.signal });
      clearTimeout(scadenza);

      if (!risposta.ok) throw new Error(`Risposta ${risposta.status}`);

      const dati = (await risposta.json()) as Risposta;
      scriviMemoria(lat, lon, dati);
      disegna(el, corpo, dati);
    } catch {
      mostraErrore(el, corpo);
    }
  }

  function avvia() {
    document.querySelectorAll<HTMLElement>('[data-meteo]').forEach((el) => {
      void carica(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', avvia, { once: true });
  } else {
    avvia();
  }
</script>
