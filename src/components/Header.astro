---
/**
 * Header — navigazione principale.
 *
 * Due stati:
 *  - `header--trasparente`: solo dove la pagina ha un'immagine a tutta larghezza
 *    in cima (la home). La barra non ha sfondo e si confonde con la fotografia.
 *  - `header--solido`: barra leggibile su fondo chiaro. È lo stato di tutte le
 *    altre pagine e della home dopo lo scroll.
 *
 * Il passaggio fra i due stati avviene con una dissolvenza gestita via CSS, e
 * il cambio di stato è l'unica cosa che fa il JavaScript — poche righe, nessuna
 * libreria.
 *
 * Il menu mobile usa <details>/<summary>: funziona anche senza JavaScript.
 */
import { site, navigazione } from '../data/site';
import { percorsoLocalizzato, linguaDaUrl } from '../i18n';
import { etichetteNavigazione, traduzioni } from '../i18n/ui';
import SelettoreLingua from './SelettoreLingua.astro';
import imgLogo from '../assets/locanda-logo.png';

export interface Props {
  /** True se la pagina inizia con un'immagine a tutta larghezza. */
  trasparente?: boolean;
}

const { trasparente = false } = Astro.props;
/** La lingua si ricava dall'indirizzo: `/en/...` e' inglese. */
const lingua = linguaDaUrl(Astro.url);
const etichette = etichetteNavigazione(lingua);
const u = traduzioni(lingua);
const path = Astro.url.pathname;

/** Una voce è attiva se la rotta corrente inizia con il suo href. */
const pulito = (p: string) => (p.length > 1 ? p.replace(/\/$/, "") : p);

const isAttiva = (href: string) => {
  const qui = pulito(percorsoLocalizzato(href, lingua));
  const corrente = pulito(path);
  return qui === '/' ? corrente === '/' : corrente === qui || corrente.startsWith(`${qui}/`);
};
---

<header
  id="header-sito"
  class:list={['site-header sticky top-0 z-50', trasparente && 'site-header--trasparente']}
  style="--header-h: 4.5rem"
  data-trasparente={trasparente ? 'true' : 'false'}
>
  <div class="shell flex h-[4.5rem] items-center justify-between gap-2 min-[380px]:gap-6">
    {/* --- Wordmark ---
        Su schermi molto stretti (320 px, il minimo richiesto dalle linee guida
        di accessibilità) il nome e il pulsante «Contatti» insieme non ci
        starebbero: il nome si rimpicciolisce di poco, e resta tutto visibile. */}
    <a
      href={percorsoLocalizzato('/', lingua)}
      class="site-header__wordmark group flex shrink-0 items-center gap-2.5 leading-none"
      aria-label={`${site.nome} — home`}
    >
      {/*
        Il logo, prima del nome. `alt` vuoto: il nome è scritto subito accanto,
        e con un alt lo si sentirebbe due volte. Sotto i 380 px resta nascosto,
        dove lo spazio è già conteso fra nome e pulsante «Contatti».
      */}
      <img
        src={imgLogo.src}
        alt=""
        width="62"
        height="48"
        decoding="async"
        class="site-header__logo hidden h-12 w-auto shrink-0 object-contain sm:block"
      />
      <span
        class="font-[family-name:var(--font-display)] text-[1.12rem] leading-none tracking-tight min-[380px]:text-[1.3rem]"
      >
        Locanda Seggiovia
      </span>
    </a>

    {/* --- Navigazione desktop --- */}
    <nav aria-label="Navigazione principale" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          navigazione.map((voce) => (
            <li>
              <a
                href={percorsoLocalizzato(voce.href, lingua)}
                aria-current={isAttiva(voce.href) ? 'page' : undefined}
                class:list={['nav-link', isAttiva(voce.href) && 'nav-link--attivo']}
              >
                {etichette[voce.href] ?? voce.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* --- Unico invito all'azione: i contatti ---
        Non c'è più anche il link testuale «Contatti» nell'elenco: portavano
        alla stessa pagina. Resta questo pulsante, l'ultimo elemento della
        barra, che è anche l'unico con il fondo ocra. */}
    <div class="flex items-center gap-3">
      {/*
        Il selettore di lingua, nella barra solo da `lg`: sotto, dove lo spazio
        è già conteso fra nome e pulsanti, sta dentro il menu a scomparsa.
      */}
      <div class="hidden lg:block">
        <SelettoreLingua />
      </div>

      <a href={percorsoLocalizzato('/contatti', lingua)} class="btn btn--primary btn--barra">
        {u.nav.contatti}
      </a>

      <details class="menu-mobile relative lg:hidden">
        <summary
          class="site-header__bottone flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm border transition-colors"
          aria-label={u.nav.apriMenu}
        >
          <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none">
            <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>

        <nav
          aria-label="Navigazione principale (mobile)"
          class="absolute top-[calc(100%+0.6rem)] right-0 w-[min(20rem,calc(100vw-2.5rem))] border border-stone-200 bg-stone-50 p-2 shadow-[0_18px_50px_-18px_rgba(28,27,25,0.35)]"
        >
          <ul>
            {
              navigazione.map((voce) => (
                <li>
                  <a
                    href={percorsoLocalizzato(voce.href, lingua)}
                    aria-current={isAttiva(voce.href) ? 'page' : undefined}
                    class:list={[
                      'block px-3 py-3 text-[0.95rem] transition-colors duration-200 hover:bg-stone-100',
                      isAttiva(voce.href) ? 'text-forest-700' : 'text-stone-700',
                    ]}
                  >
                    {etichette[voce.href] ?? voce.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-stone-200 pt-1">
              <a href={percorsoLocalizzato('/contatti', lingua)} class="btn btn--primary mt-1 w-full">
                {u.nav.contatti}
              </a>
            </li>
            <li class="mt-2 flex justify-center border-t border-stone-200 pt-3">
              <SelettoreLingua />
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* ==========================================================================
     Due stati della barra
     ========================================================================== */

  .site-header {
    transition:
      background-color 0.5s var(--ease-alpine),
      border-color 0.5s var(--ease-alpine),
      backdrop-filter 0.5s var(--ease-alpine);
    border-bottom: 1px solid transparent;
  }

  /* Stato solido: quello di default, leggibile su fondo chiaro. */
  .site-header {
    background-color: color-mix(in oklab, var(--color-stone-100) 88%, transparent);
    border-bottom-color: color-mix(in oklab, var(--color-stone-200) 80%, transparent);
    backdrop-filter: blur(12px);
  }

  /* Stato trasparente: solo in cima alle pagine con immagine a tutta larghezza,
     e SOLO se JavaScript è attivo (la classe `js-ready` la mette lo script).
     Senza JavaScript la barra resta solida e leggibile: la trasparenza è un
     miglioramento, non un requisito. */
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) {
    background-color: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  .site-header__wordmark {
    color: var(--color-stone-900);
    transition: color 0.5s var(--ease-alpine);
  }
  .site-header__sotto {
    color: var(--color-stone-500);
    transition: color 0.5s var(--ease-alpine);
  }
  .site-header__bottone {
    border-color: var(--color-stone-300);
    color: var(--color-stone-700);
    transition:
      color 0.5s var(--ease-alpine),
      border-color 0.5s var(--ease-alpine);
  }

  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .site-header__wordmark {
    color: var(--color-stone-50);
    /* Leggibilità sopra la fotografia. */
    text-shadow: 0 1px 12px rgb(28 27 25 / 0.5);
  }
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .site-header__sotto {
    color: color-mix(in oklab, var(--color-stone-50) 75%, transparent);
    text-shadow: 0 1px 12px rgb(28 27 25 / 0.5);
  }
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .site-header__bottone {
    border-color: color-mix(in oklab, var(--color-stone-50) 45%, transparent);
    color: var(--color-stone-50);
  }

  /* ==========================================================================
     Voce di navigazione con sottolineatura che si allunga
     ========================================================================== */

  .nav-link {
    position: relative;
    display: inline-block;
    padding-bottom: 0.35rem;
    font-size: 0.9rem;
    white-space: nowrap;
    color: var(--color-stone-700);
    text-decoration: none;
    transition: color 0.35s var(--ease-alpine);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    /* Parte da sinistra e si allunga: è il gesto che segnala il passaggio. */
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.28s var(--ease-alpine);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-link:hover {
    color: var(--color-forest-700);
  }

  /* La voce della pagina corrente tiene la sottolineatura, senza animazione. */
  .nav-link--attivo {
    color: var(--color-forest-700);
  }
  .nav-link--attivo::after {
    transform: scaleX(1);
    transition: none;
  }

  /* Sopra la fotografia le voci sono chiare. */
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .nav-link {
    color: color-mix(in oklab, var(--color-stone-50) 88%, transparent);
    text-shadow: 0 1px 12px rgb(28 27 25 / 0.5);
  }
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .nav-link:hover,
  :global(.js-ready) .site-header--trasparente:not(.site-header--solido) .nav-link--attivo {
    color: var(--color-stone-50);
  }

  /* --- Menu mobile --- */
  .menu-mobile > summary::-webkit-details-marker {
    display: none;
  }
  .menu-mobile > summary::marker {
    content: '';
  }

  /* Con movimento ridotto la sottolineatura compare senza scorrere. */
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Fa passare la barra da trasparente a solida.
   *
   * Si legge la posizione di scroll dentro requestAnimationFrame, così il
   * calcolo avviene una volta per frame invece che a ogni evento.
   * Se JavaScript non è attivo la barra resta solida: sempre leggibile.
   */
  const header = document.getElementById('header-sito');

  if (header && header.dataset.trasparente === 'true') {
    // Soglia bassa: la barra deve diventare solida appena si lascia la fotografia.
    const SOGLIA = 40;
    let inCoda = false;

    const aggiorna = () => {
      const solido = window.scrollY > SOGLIA;
      header.classList.toggle('site-header--solido', solido);
      inCoda = false;
    };

    aggiorna();

    window.addEventListener(
      'scroll',
      () => {
        if (inCoda) return;
        inCoda = true;
        requestAnimationFrame(aggiorna);
      },
      { passive: true },
    );
  }
</script>
