---
/**
 * Header — navigazione principale.
 *
 * Il menu mobile usa <details>/<summary>: funziona anche senza JavaScript,
 * quindi resta utilizzabile con rete debole o JS non caricato.
 */
import { site, navigazione } from '../data/site';

const path = Astro.url.pathname;

/** Una voce è attiva se la rotta corrente inizia con il suo href. */
const isAttiva = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-100/85 backdrop-blur-md"
  style="--header-h: 4.5rem"
>
  <div class="shell flex h-[4.5rem] items-center justify-between gap-6">
    {/* --- Wordmark --- */}
    <a
      href="/"
      class="group flex shrink-0 items-baseline gap-2.5 leading-none"
      aria-label={`${site.nome} — home`}
    >
      <span class="font-[family-name:var(--font-display)] text-[1.3rem] leading-none tracking-tight text-stone-900">
        Locanda Seggiovia
      </span>
      <span
        class="hidden text-[0.68rem] leading-none tracking-[0.14em] text-stone-500 uppercase sm:inline"
      >
        Recoaro Terme
      </span>
    </a>

    {/* --- Navigazione desktop --- */}
    <nav aria-label="Navigazione principale" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          navigazione.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={isAttiva(voce.href) ? 'page' : undefined}
                class:list={[
                  'text-[0.9rem] whitespace-nowrap transition-colors duration-300 hover:text-forest-700',
                  isAttiva(voce.href)
                    ? 'text-forest-700 underline decoration-forest-700/40 decoration-1 underline-offset-[0.4em]'
                    : 'text-stone-700',
                ]}
              >
                {voce.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* --- CTA + menu mobile --- */}
    <div class="flex items-center gap-3">
      <a href="/contatti" class="btn btn--primary hidden sm:inline-flex">Prenota</a>

      <details class="menu-mobile relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm border border-stone-300 text-stone-700 transition-colors hover:border-stone-500"
          aria-label="Apri il menu di navigazione"
        >
          <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none">
            <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>

        <nav
          aria-label="Navigazione principale (mobile)"
          class="absolute top-[calc(100%+0.6rem)] right-0 w-[min(20rem,calc(100vw-2.5rem))] border border-stone-200 bg-stone-50 p-2 shadow-[0_18px_50px_-18px_rgba(28,27,25,0.35)]"
        >
          <ul>
            {
              navigazione.map((voce) => (
                <li>
                  <a
                    href={voce.href}
                    aria-current={isAttiva(voce.href) ? 'page' : undefined}
                    class:list={[
                      'block px-3 py-3 text-[0.95rem] transition-colors duration-200 hover:bg-stone-100',
                      isAttiva(voce.href) ? 'text-forest-700' : 'text-stone-700',
                    ]}
                  >
                    {voce.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-stone-200 pt-1">
              <a href="/contatti" class="btn btn--primary mt-1 w-full">Prenota un soggiorno</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Nasconde il marcatore nativo di <summary>. */
  .menu-mobile > summary::-webkit-details-marker {
    display: none;
  }
  .menu-mobile > summary::marker {
    content: '';
  }

  /* Chiusura del menu al click su una voce: <details> non lo fa da sé,
     ma il browser naviga comunque verso la nuova pagina. */
</style>
