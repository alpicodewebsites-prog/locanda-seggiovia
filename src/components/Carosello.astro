---
/**
 * La striscia di fotografie della home.
 *
 * ----------------------------------------------------------------------------
 * NON È PIÙ UN RIQUADRO
 *
 * Prima c'era un pannello di vetro con dentro una fotografia per volta. Ora le
 * fotografie scorrono da sole su tutta la larghezza della pagina, e ai due
 * estremi sfumano nel fondo: non c'è un bordo che le taglia, non c'è una cornice
 * che le rinchiude. La fotografia arriva da fuori schermo ed esce dall'altra
 * parte, e questo è tutto il disegno.
 *
 * La dissolvenza non è un'ombra: è una maschera (`mask-image`). Sfuma davvero
 * la fotografia lasciando vedere il fondo della pagina sotto, invece di
 * appoggiarci sopra un velo chiaro che la sporcherebbe.
 *
 * ----------------------------------------------------------------------------
 * COME SCORRE SENZA SCATTI
 *
 * La pista contiene le fotografie DUE volte e si sposta di metà della sua
 * lunghezza. Quando la prima copia è uscita, la seconda è esattamente al suo
 * posto: il salto è invisibile. Perché il conto torni, la distanza fra le
 * fotografie è un `margin` su ciascuna e non un `gap` — con il `gap` la metà
 * cadrebbe mezza distanza più in là e si vedrebbe uno scatto a ogni giro.
 *
 * La seconda copia è `aria-hidden` e non contiene collegamenti: è la stessa
 * fotografia, non una seconda.
 *
 * Si ferma al passaggio del puntatore e col fuoco da tastiera. Con
 * `prefers-reduced-motion` non parte affatto: chi ha chiesto meno movimento vede
 * una fila ferma, che può far scorrere col dito o con la barra.
 * ----------------------------------------------------------------------------
 */
import { Image } from 'astro:assets';

import { risolviImmagine } from '../lib/immagini';
import { percorsoLocalizzato, type Lingua } from '../i18n';

export interface Props {
  diapositive: {
    titolo: string;
    testo: string;
    immagine?: string;
    collegamento: string;
  }[];
  lingua: Lingua;
  /** Titolo per i lettori di schermo. */
  etichetta: string;
  /* Restano dichiarate perché la pagina le passa ancora: la striscia non ha
     comandi, ma toglierle dall'interfaccia obbligherebbe a cambiare anche il
     chiamante per niente. */
  invito?: string;
  precedente?: string;
  successiva?: string;
}

const { diapositive, lingua, etichetta } = Astro.props;

const voci = diapositive
  .map((voce) => ({ ...voce, img: risolviImmagine(voce.immagine) }))
  .filter((voce) => voce.img !== null);

if (voci.length === 0) {
  throw new Error("Striscia: nessuna fotografia con un'immagine valida.");
}
---

<section class="striscia-sezione" aria-labelledby="titolo-striscia">
  <div class="shell">
    <h2 id="titolo-striscia" class="sr-only">{etichetta}</h2>
  </div>

  {/*
    `data-carosello` è rimasto per gli script di verifica, che cercano questo
    gancio per trovare la striscia in pagina.
  */}
  <div class="striscia" data-carosello>
    <ul class="striscia__pista">
      {/* Prima copia: quella vera, con i collegamenti attivi. */}
      {
        voci.map((voce) => (
          <li class="striscia__voce">
            <a href={percorsoLocalizzato(voce.collegamento, lingua)} class="striscia__link">
              <span class="striscia__foto">
                <Image
                  src={voce.img!}
                  alt={voce.titolo}
                  widths={[420, 640, 900]}
                  sizes="(min-width: 64rem) 26rem, 80vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="striscia__etichetta">{voce.titolo}</span>
            </a>
          </li>
        ))
      }

      {/* Seconda copia: identica, solo per far tornare il giro. */}
      {
        voci.map((voce) => (
          <li class="striscia__voce" aria-hidden="true">
            <span class="striscia__link">
              <span class="striscia__foto">
                <Image
                  src={voce.img!}
                  alt=""
                  widths={[420, 640, 900]}
                  sizes="(min-width: 64rem) 26rem, 80vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="striscia__etichetta">{voce.titolo}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .striscia-sezione {
    /* Meno aria sopra e sotto: è una fascia, non una sezione di testo. */
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }

  /*
    La maschera che sfuma gli estremi. È ciò che rende la striscia «senza
    bordi»: la fotografia non finisce, si dissolve nel fondo della pagina.
  */
  .striscia {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 9%,
      #000 91%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
  }

  .striscia__pista {
    display: flex;
    align-items: flex-start;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: scorri 52s linear infinite;
    will-change: transform;
  }

  /*
    Metà esatta della pista: la seconda copia prende il posto della prima senza
    che si veda il salto. Funziona perché la distanza fra le voci è un margine
    su ciascuna: con un `gap` sulla pista la metà cadrebbe altrove.
  */
  @keyframes scorri {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .striscia__voce {
    flex: none;
    margin-right: 1.5rem;
  }

  .striscia__link {
    display: block;
    width: clamp(16rem, 29vw, 30rem);
    text-decoration: none;
  }

  .striscia__foto {
    display: block;
    overflow: hidden;
    border-radius: var(--raggio);
    background-color: var(--color-stone-300);
  }

  .striscia__foto img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .striscia__link:hover img,
  .striscia__link:focus-visible img {
    transform: scale(1.03);
  }

  .striscia__etichetta {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-stone-600);
    transition: color 200ms ease-out;
  }

  .striscia__link:hover .striscia__etichetta,
  .striscia__link:focus-visible .striscia__etichetta {
    color: var(--color-rosso-locanda);
  }

  .striscia__link:focus-visible {
    outline: 2px solid var(--color-rosso-locanda);
    outline-offset: 6px;
    border-radius: var(--raggio);
  }

  /* Chi guarda si ferma: la striscia si ferma con lui. */
  .striscia:hover .striscia__pista,
  .striscia:focus-within .striscia__pista {
    animation-play-state: paused;
  }

  /*
    Con meno movimento richiesto la striscia non scorre. Diventa una fila che si
    può far scorrere col dito o con la barra: il contenuto resta raggiungibile.
  */
  @media (prefers-reduced-motion: reduce) {
    .striscia {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .striscia__pista {
      animation: none;
    }

    .striscia__foto img {
      transition: none;
    }

    .striscia__link:hover img {
      transform: none;
    }
  }
</style>
